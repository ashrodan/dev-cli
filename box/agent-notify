#!/usr/bin/env python3
"""agent-notify — push a notification when a herdr agent needs you or finishes.

Polls `herdr agent list` and watches for state transitions. herdr's agent-state
hooks (claude, codex, grok, omp, pi) keep those states accurate, so this only has
to diff them.

Notifies on:
  working -> blocked        the agent is waiting on you
  working -> idle | done    the agent finished

Deliberately silent on idle -> working and anything involving `unknown`, which
flaps when a pane is redrawing.

Delivery is the exe.dev notify integration, which pushes to every device signed
into the exe.dev app. No credential lives here: the integration proxy injects it.
"""

import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

HERDR = os.environ.get("AGENT_NOTIFY_HERDR", os.path.expanduser("~/.local/bin/herdr"))
# ntfy is the primary courier: it carries a click target, so the notification
# can open Termius rather than whichever app happens to own the push channel.
NTFY_BASE = os.environ.get("AGENT_NOTIFY_NTFY", "")      # e.g. http://100.75.93.117:2586
NTFY_TOPIC = os.environ.get("AGENT_NOTIFY_TOPIC", "")
CLICK = os.environ.get("AGENT_NOTIFY_CLICK", "termius://")
# ntfy allows up to three action buttons. `termius://` only launches the app —
# the scheme carries no route, so there is no way to target a specific host.
ACTION_LABEL = os.environ.get("AGENT_NOTIFY_ACTION_LABEL", "Open Termius")
# agent-action endpoint, tailnet-only, for the Continue button on blocked agents
ACTION_URL = os.environ.get("AGENT_ACTION_URL", "")
ACTION_TOKEN_FILE = os.environ.get("AGENT_ACTION_TOKEN_FILE", "/etc/agent-action/token")


def action_token():
    try:
        return open(ACTION_TOKEN_FILE).read().strip()
    except OSError:
        return ""
# exe.dev push, kept as a fallback; no click target, opens the exe.dev app
EXE_URL = os.environ.get("AGENT_NOTIFY_EXE", "")
POLL_SECONDS = float(os.environ.get("AGENT_NOTIFY_POLL", "5"))
HOST = os.environ.get("AGENT_NOTIFY_HOST", os.uname().nodename)

# transitions worth waking a phone for
ALERT_ON = {
    #  state  -> (label, ntfy priority, ntfy tag)
    "blocked": ("needs you", 4, "warning"),
    "idle": ("finished", 3, "white_check_mark"),
    "done": ("finished", 3, "white_check_mark"),
}


def log(msg):
    print(msg, flush=True)


def agents():
    """Current agent panes, keyed by pane_id."""
    try:
        out = subprocess.run(
            [HERDR, "agent", "list"],
            capture_output=True, text=True, timeout=15,
        )
    except (subprocess.TimeoutExpired, OSError) as e:
        log(f"herdr agent list failed: {e}")
        return None
    if out.returncode != 0:
        return None
    try:
        result = json.loads(out.stdout).get("result", {})
    except json.JSONDecodeError:
        return None

    found = {}
    for a in result.get("agents", []):
        pane = a.get("pane_id")
        if not pane:
            continue
        title = (a.get("terminal_title_stripped") or "").strip()
        # omp/pi prefix titles with the model glyph and a caret
        for sep in (" > ", "> "):
            if sep in title:
                title = title.split(sep, 1)[1].strip()
                break
        found[pane] = {
            "agent": a.get("agent") or "agent",
            "status": a.get("agent_status") or "unknown",
            "cwd": os.path.basename((a.get("cwd") or "").rstrip("/")) or "~",
            "title": title,
            "workspace": a.get("workspace_id") or "",
        }
    return found


def post(url, payload):
    req = urllib.request.Request(
        url, data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"}, method="POST",
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        return resp.read().decode()


def notify(title, message, priority=3, tag="", pane="", blocked=False):
    """Publish to every configured courier; one failing must not silence others."""
    sent = []

    if NTFY_BASE and NTFY_TOPIC:
        # JSON publishing rather than headers: titles contain non-ASCII
        # (· and —) which cannot travel in an HTTP header.
        body = {
            "topic": NTFY_TOPIC,
            "title": title,
            "message": message,
            "priority": priority,
        }
        actions = []
        if CLICK:
            body["click"] = CLICK
            if ACTION_LABEL:
                actions.append({
                    "action": "view",
                    "label": ACTION_LABEL,
                    "url": CLICK,
                    "clear": True,      # dismiss the notification once tapped
                })

        # Continue is offered only where it means something: an agent that is
        # actually waiting. The endpoint re-checks state on arrival anyway, so a
        # stale notification cannot inject a keystroke into a running agent.
        tok = action_token()
        if blocked and pane and ACTION_URL and tok:
            actions.append({
                "action": "http",
                "label": "Continue",
                "url": f"{ACTION_URL.rstrip('/')}/continue?pane={pane}",
                "method": "POST",
                "headers": {"Authorization": f"Bearer {tok}"},
                "clear": True,
            })

        if actions:
            body["actions"] = actions
        if tag:
            body["tags"] = [tag]
        try:
            post(NTFY_BASE.rstrip("/") + "/", body)
            sent.append("ntfy")
        except (urllib.error.URLError, OSError) as e:
            log(f"ntfy failed: {e}")

    if EXE_URL:
        try:
            post(EXE_URL, {"title": title, "message": message})
            sent.append("exe")
        except (urllib.error.URLError, OSError) as e:
            log(f"exe.dev notify failed: {e}")

    log(f"[{','.join(sent) or 'nowhere'}] {title} — {message}")


def main():
    previous = {}
    first_pass = True

    while True:
        current = agents()
        if current is None:
            time.sleep(POLL_SECONDS)
            continue

        if first_pass:
            # adopt the current state silently, or restarting the service would
            # fire a notification for every agent already sitting idle
            previous = {k: v["status"] for k, v in current.items()}
            first_pass = False
            log(f"watching {len(current)} agent(s) on {HOST}")
            time.sleep(POLL_SECONDS)
            continue

        for pane, info in current.items():
            was = previous.get(pane)
            now = info["status"]
            if was == now:
                continue
            previous[pane] = now

            # only care about leaving `working` for a state that wants attention
            if was == "working" and now in ALERT_ON:
                what, priority, tag = ALERT_ON[now]
                title = f"{info['agent']} · {info['cwd']} — {what}"
                message = info["title"] or f"workspace {info['workspace']}"
                notify(title, message, priority, tag,
                       pane=pane, blocked=(now == "blocked"))

        # forget panes that have gone away
        for pane in list(previous):
            if pane not in current:
                del previous[pane]

        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
