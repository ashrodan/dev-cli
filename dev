#!/usr/bin/env bash
# dev — worktree-first navigator for the herdr dev box.
#
#   dev              browse worktrees
#                      ↑ ↓     move, preview updates live
#                      → enter open the action menu
#                      ←  esc  back out / quit
#                      ctrl-o  VS Code     ctrl-h  herdr
#                      ctrl-p  preview     ctrl-e  env push
#                      ctrl-r  refresh
#   dev ls           list every worktree, with any servers it is running
#   dev ps           list listening servers on the box, with preview URLs
#   dev new [repo] <branch> [--base ref]
#   dev rm   [query]
#   dev code [query]                 open in VS Code
#   dev herdr [query]                attach the herdr session there
#   dev preview [query]              open a running server in the browser
#   dev env push|ls|diff [query] [--from FILE]
#   dev ask [-a agent] [-w query] [question...]
#
# Worktrees are the unit of work. The main checkout is just the worktree that
# happens to hold the primary branch.

set -uo pipefail

REMOTE="${DEV_REMOTE:-dai}"
RHOME="${DEV_REMOTE_HOME:-/home/exedev}"
HERDR="$RHOME/.local/bin/herdr"
WT_ROOT="${DEV_WT_ROOT:-$RHOME/worktrees}"
SESSION="${DEV_SESSION:-default}"
PROXY_HOST="${DEV_PROXY_HOST:-herdr-1.exe.xyz}"
TS_HOST="${DEV_TS_HOST:-herdr-1}"
PROXY_PORT="${DEV_PROXY_PORT:-8000}"

die()  { printf 'dev: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# --- remote scan -----------------------------------------------------------
# One SSH round trip. Tab separated:
#   1 repo  2 branch  3 path  4 workspace  5 kind  6 ports
#   7 sha   8 when    9 dirty 10 ahead    11 behind  12 subject
scan() {
  ssh "$REMOTE" "RHOME='$RHOME' HERDR='$HERDR' bash -s" <<'REMOTE_EOF'
set -uo pipefail
export PATH="$RHOME/.local/bin:$PATH"

repos=$(find "$RHOME" -maxdepth 3 -name .git \
        -not -path '*/node_modules/*' -not -path "$RHOME/.*" \
        -printf '%h\n' 2>/dev/null | sort -u)

{
  for repo in $repos; do "$HERDR" worktree list --cwd "$repo" 2>/dev/null; done

  echo '---PORTS---'
  ss -tlnpH 2>/dev/null | while read -r line; do
    addr=$(printf '%s' "$line" | awk '{print $4}')
    port=${addr##*:}; host=${addr%:*}
    pid=$(printf '%s' "$line" | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)
    [ -z "$pid" ] && continue
    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || continue
    cmd=$(tr -d '\0' < "/proc/$pid/comm" 2>/dev/null)
    case "$host" in 127.0.0.1|'[::1]') scope=l ;; *) scope=g ;; esac
    printf '%s\t%s\t%s\t%s\n' "$port" "$scope" "$cwd" "$cmd"
  done

  echo '---GIT---'
  for repo in $repos; do
    git -C "$repo" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}' |
    while read -r wt; do
      sha=$(git -C "$wt" log -1 --format=%h 2>/dev/null)
      when=$(git -C "$wt" log -1 --format=%cr 2>/dev/null)
      subj=$(git -C "$wt" log -1 --format=%s 2>/dev/null | tr '\t|' '  ' | cut -c1-68)
      dirty=$(git -C "$wt" status --porcelain 2>/dev/null | grep -c . || true)
      ab=$(git -C "$wt" rev-list --count --left-right '@{u}...HEAD' 2>/dev/null || printf '0\t0')
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$wt" "$sha" "$when" "$dirty" \
        "$(printf '%s' "$ab" | cut -f2)" "$(printf '%s' "$ab" | cut -f1)" "$subj"
    done
  done
} | python3 -c '
import json, sys

blocks = sys.stdin.read().split("---PORTS---")
wt_lines = blocks[0].splitlines()
rest     = blocks[1] if len(blocks) > 1 else ""
pblock, _, gblock = rest.partition("---GIT---")

servers = [p.split("\t") for p in pblock.splitlines() if p.count("\t") == 3]

meta = {}
for line in gblock.splitlines():
    f = line.split("\t")
    if len(f) == 7:
        meta[f[0]] = f[1:]

worktrees, seen = [], set()
for line in wt_lines:
    line = line.strip()
    if not line:
        continue
    try:
        res = json.loads(line).get("result", {})
    except Exception:
        continue
    repo = res.get("source", {}).get("repo_name", "?")
    for w in res.get("worktrees", []):
        path = w.get("path", "")
        if not path or path in seen:
            continue
        seen.add(path)
        worktrees.append((repo, w.get("branch") or "(detached)", path,
                          w.get("open_workspace_id") or "",
                          "linked" if w.get("is_linked_worktree") else "main"))

for repo, branch, path, ws, kind in sorted(worktrees, key=lambda r: -len(r[2])):
    ports = sorted({p + ("l" if s == "l" else "")
                    for p, s, cwd, _ in servers
                    if cwd == path or cwd.startswith(path.rstrip("/") + "/")})
    m = meta.get(path, ["", "", "0", "0", "0", ""])
    print("\t".join([repo, branch, path, ws, kind, ",".join(ports)] + m))

sys.stderr.write("".join(
    "ORPHAN\t%s\t%s\t%s\t%s\n" % (p, s, c, m)
    for p, s, c, m in servers
    if not any(c == w[2] or c.startswith(w[2].rstrip("/") + "/") for w in worktrees)))
'
REMOTE_EOF
}

url_for() {
  local p="${1%l}"
  if [ "${1: -1}" = l ]; then printf 'http://127.0.0.1:%s/\n' "$p"
  elif [ "$p" = "$PROXY_PORT" ]; then printf 'https://%s/\n' "$PROXY_HOST"
  elif [ "$p" -ge 3000 ] 2>/dev/null && [ "$p" -le 9999 ]; then printf 'https://%s:%s/\n' "$PROXY_HOST" "$p"
  else printf 'http://%s:%s/\n' "$TS_HOST" "$p"; fi
}

fmt() {
  awk -F'\t' '{
    mark  = ($4 == "" ? "  " : "\033[32m●\033[0m ")
    srv   = ($6 == "" ? "        " : sprintf("\033[36m▶ %-6s\033[0m", $6))
    dirty = ($9 + 0 > 0 ? sprintf("\033[33m*%-3s\033[0m", $9) : "    ")
    printf "%s%-13s  \033[1m%-34s\033[0m %s %s %s\n", mark, $1, $2, dirty, srv, $3
  }'
}

# --- live preview pane -----------------------------------------------------
# Rendered from the cached scan, so arrowing through the list costs nothing.
cmd_pane() {
  local path="$1" cache="${DEV_CACHE:-}"
  [ -n "$cache" ] && [ -f "$cache" ] || return 0
  # Tab is an IFS *whitespace* character, so `IFS=$'\t' read` collapses runs of
  # tabs and drops empty fields — a row with no open workspace or no listening
  # ports would shift every later field left and render nonsense. \037 is not
  # whitespace, so each occurrence delimits exactly one field.
  awk -F'\t' -v p="$path" '$3==p' "$cache" | tr '\t' '\037' |
  while IFS=$'\037' read -r repo branch wpath ws kind ports sha when dirty ahead behind subject; do
    printf '\033[1;37m%s\033[0m  \033[2m%s\033[0m\n\n' "$repo" "$kind"
    printf '  \033[2mbranch\033[0m   \033[1m%s\033[0m\n' "$branch"
    printf '  \033[2mpath\033[0m     %s\n' "$wpath"
    [ -n "$sha" ] && printf '  \033[2mhead\033[0m     %s  \033[2m%s\033[0m\n           %s\n' "$sha" "$when" "$subject"

    printf '\n'
    if [ "${dirty:-0}" -gt 0 ] 2>/dev/null; then
      printf '  \033[33m● %s uncommitted file(s)\033[0m\n' "$dirty"
    else
      printf '  \033[32m● clean\033[0m\n'
    fi
    [ "${ahead:-0}" -gt 0 ] 2>/dev/null  && printf '  \033[36m↑ %s ahead of upstream\033[0m\n' "$ahead"
    [ "${behind:-0}" -gt 0 ] 2>/dev/null && printf '  \033[35m↓ %s behind upstream\033[0m\n' "$behind"
    [ -n "$ws" ] && printf '  \033[32m● herdr workspace %s open\033[0m\n' "$ws"

    if [ -n "$ports" ]; then
      printf '\n  \033[1mserving\033[0m\n'
      for p in $(printf '%s' "$ports" | tr ',' ' '); do
        if [ "${p: -1}" = l ]; then
          printf '    %-6s \033[31mlocalhost-bound, not reachable\033[0m\n' "${p%l}"
        else
          printf '    %-6s \033[4m%s\033[0m\n' "$p" "$(url_for "$p")"
        fi
      done
    fi
  done
}

# --- actions ---------------------------------------------------------------
open_code() {
  need code
  code --remote "ssh-remote+$REMOTE" "$1" && printf 'dev: opened %s in VS Code\n' "$1"
}

# --- terminal hygiene ------------------------------------------------------
# A dropped SSH leaves the *remote* TUI's modes set on *our* terminal: alt
# screen, hidden cursor, mouse reporting, bracketed paste, application keypad.
# herdr undoes these on a clean detach (prefix+q), but a connection that dies
# never gets the chance — which is why the local terminal misbehaves afterwards.
# Always hand the terminal back in a known state.
term_restore() {
  [ -t 1 ] || return 0
  printf '\033[?1049l\033[?25h\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?2004l\033[?7h\033[?1l\033>\033(B\033[m'
  stty sane 2>/dev/null || true
}

# Run an interactive remote command and exit, restoring the terminal either way.
# Replaces a bare `exec ssh`, which leaves no opportunity to clean up.
remote_tty() {
  ssh -t "$REMOTE" "$1"
  local rc=$?
  term_restore
  exit $rc
}

open_herdr() {
  local path="$1" ws
  ws=$(ssh "$REMOTE" "$HERDR worktree open --path '$path' 2>/dev/null" |
       python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("result",{}).get("workspace_id","") or "")
except Exception: print("")' 2>/dev/null)
  [ -n "$ws" ] && ssh "$REMOTE" "$HERDR workspace focus $ws" >/dev/null 2>&1
  remote_tty "$HERDR --session $SESSION"
}

open_shell() { remote_tty "cd '$1' && exec \$SHELL -l"; }

open_preview() {
  local path="$1" ports="$2" choice port url
  if [ -z "$ports" ]; then
    printf 'dev: nothing listening in %s\n' "$path" >&2
    printf '     start a server there, and bind 0.0.0.0 not 127.0.0.1\n' >&2
    return 1
  fi
  if [ "$(printf '%s' "$ports" | tr ',' '\n' | grep -c .)" -gt 1 ]; then
    need fzf
    choice=$(printf '%s' "$ports" | tr ',' '\n' |
             while read -r p; do printf '%s\t%s\n' "$p" "$(url_for "$p")"; done |
             fzf --prompt='port> ' --reverse --height=30% --delimiter='\t' --with-nth=2) || return 1
    port=$(printf '%s' "$choice" | cut -f1)
  else
    port="$ports"
  fi
  if [ "${port: -1}" = l ]; then
    printf 'dev: port %s is bound to 127.0.0.1 on the box, so the proxy cannot see it.\n' "${port%l}" >&2
    printf '     restart it with --host 0.0.0.0\n' >&2
    return 1
  fi
  url=$(url_for "$port")
  printf 'dev: opening %s\n' "$url"
  open "$url"
}

# --- action menu -----------------------------------------------------------
# Returns 1 when the user backs out, so the caller can redraw the list.
action_menu() {
  need fzf
  local path="$1" ports="$2" srv="none" out key choice
  [ -n "$ports" ] && srv="$ports"
  out=$(printf '%s\n' \
    "herdr    attach the herdr session here" \
    "code     open in VS Code (Remote-SSH)" \
    "preview  open a running server ($srv)" \
    "env      copy .env vars into this worktree" \
    "ask      ask an agent, in this directory" \
    "shell    plain ssh shell here" \
    "rm       remove this worktree" |
    fzf --prompt='action> ' --reverse --height=35% --expect=left,esc \
        --header="$(basename "$path")  —  ← back") || return 1
  key=$(printf '%s\n' "$out" | sed -n 1p)
  choice=$(printf '%s\n' "$out" | sed -n 2p)
  case "$key" in left|esc) return 1 ;; esac
  [ -z "$choice" ] && return 1

  case "${choice%% *}" in
    herdr)   open_herdr "$path" ;;
    code)    open_code "$path" ;;
    preview) open_preview "$path" "$ports" ;;
    env)     cmd_env push -p "$path" ;;
    ask)     cmd_ask -p "$path" ;;
    shell)   open_shell "$path" ;;
    rm)      rm_worktree "$path" ;;
  esac
  return 0
}

# --- picker ----------------------------------------------------------------
# NOTE: pick() runs inside $( ), i.e. a subshell — anything it assigns to a
# global is discarded. It therefore *prints* its result and resolve() unpacks it
# in the calling shell. This is what previously broke every non-default key.
CACHE=""
cleanup() { [ -n "$CACHE" ] && rm -f "$CACHE"; }
trap cleanup EXIT

refresh_cache() {
  [ -z "$CACHE" ] && CACHE=$(mktemp "${TMPDIR:-/tmp}/dev-scan.XXXXXX")
  scan 2>/dev/null > "$CACHE" || die "could not reach $REMOTE"
  export DEV_CACHE="$CACHE"
  [ -s "$CACHE" ] || die "no git repositories found under $RHOME"
}

pick() {
  need fzf
  local out key line path ports
  if [ -n "${1:-}" ]; then
    local hit; hit=$(grep -i -- "$1" "$CACHE" || true)
    if [ "$(printf '%s\n' "$hit" | grep -c .)" = 1 ]; then
      printf '\t%s\t%s\n' "$(printf '%s' "$hit" | cut -f3)" "$(printf '%s' "$hit" | cut -f6)"
      return 0
    fi
  fi

  out=$(fmt < "$CACHE" |
        fzf --ansi --reverse --height=100% --prompt='worktree> ' --query="${1:-}" \
            --header='↑↓ move   →/enter menu   ctrl-o code   ctrl-h herdr   ctrl-p preview   ctrl-e env   ctrl-r refresh' \
            --preview="$0 _pane {-1}" --preview-window='right,52%,border-left,wrap' \
            --expect=right,ctrl-o,ctrl-h,ctrl-p,ctrl-e,ctrl-r) || return 1

  key=$(printf '%s\n' "$out" | sed -n 1p)
  line=$(printf '%s\n' "$out" | sed -n 2p)
  [ -z "$line" ] && return 1
  path=$(printf '%s' "$line" | awk '{print $NF}')
  ports=$(awk -F'\t' -v p="$path" '$3==p{print $6}' "$CACHE")
  printf '%s\t%s\t%s\n' "$key" "$path" "$ports"
}

REPLY_KEY=""; REPLY_PATH=""; REPLY_PORTS=""
resolve() {
  local r; r=$(pick "${1:-}") || return 1
  REPLY_KEY=$(printf '%s' "$r"  | cut -f1)
  REPLY_PATH=$(printf '%s' "$r" | cut -f2)
  REPLY_PORTS=$(printf '%s' "$r" | cut -f3)
  [ -n "$REPLY_PATH" ]
}

# --- browse loop -----------------------------------------------------------
browse() {
  refresh_cache
  while true; do
    resolve "${1:-}" || return 0
    set --                                   # query applies to the first pass only
    case "$REPLY_KEY" in
      ctrl-r) refresh_cache; continue ;;
      ctrl-o) open_code    "$REPLY_PATH" ;;
      ctrl-h) open_herdr   "$REPLY_PATH" ;;   # exec, never returns
      ctrl-p) open_preview "$REPLY_PATH" "$REPLY_PORTS" || true ;;
      ctrl-e) cmd_env push -p "$REPLY_PATH" ;;
      *)      action_menu  "$REPLY_PATH" "$REPLY_PORTS" || continue ;;
    esac
    refresh_cache                            # state may have changed
  done
}

# --- subcommands -----------------------------------------------------------
cmd_ls() { refresh_cache; fmt < "$CACHE"; }

cmd_ps() {
  local orphans; orphans=$(scan 2>&1 >/dev/null | grep '^ORPHAN' || true)
  refresh_cache
  echo "servers in worktrees"
  awk -F'\t' '$6!=""{print $1 "\037" $6}' "$CACHE" | while IFS=$'\037' read -r repo ports; do
    for p in $(printf '%s' "$ports" | tr ',' ' '); do
      printf '  %-13s %-8s %s\n' "$repo" "${p%l}" "$(url_for "$p")"
    done
  done
  [ -n "$orphans" ] && {
    echo "other listeners"
    printf '%s\n' "$orphans" | tr '\t' '\037' |
    while IFS=$'\037' read -r _ port scope cwd cmd; do
      [ "$scope" = l ] && continue
      printf '  %-13s %-8s %s\n' "$cmd" "$port" "$(url_for "$port")"
    done
  }
  return 0
}

cmd_new() {
  local repo="" branch="" base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) base="$2"; shift 2 ;;
      *) if [ -z "$branch" ] && [ -n "$repo" ]; then branch="$1"
         elif [ -z "$repo" ]; then repo="$1"
         else branch="$1"; fi; shift ;;
    esac
  done
  [ -z "$branch" ] && { branch="$repo"; repo=""; }
  [ -z "$branch" ] && die "usage: dev new [repo] <branch> [--base ref]"

  refresh_cache
  if [ -z "$repo" ]; then
    need fzf
    repo=$(awk -F'\t' '$5=="main"{print $1"\t"$3}' "$CACHE" | sort -u |
           fzf --prompt='repo> ' --reverse --height=30% --with-nth=1 --delimiter='\t') || return 1
    repo=$(printf '%s' "$repo" | cut -f2)
  fi
  [ -z "$repo" ] && die "no repo selected"

  local slug path
  slug=$(printf '%s' "$branch" | tr '/' '-')
  path="$WT_ROOT/$(basename "$repo")/$slug"
  local args="--cwd '$repo' --branch '$branch' --path '$path' --focus"
  [ -n "$base" ] && args="$args --base '$base'"

  ssh "$REMOTE" "mkdir -p '$(dirname "$path")' && $HERDR worktree create $args" >/dev/null \
    || die "worktree create failed"
  printf 'dev: created %s on %s\n' "$path" "$branch"
}

rm_worktree() {
  local path="$1" ws
  ws=$(awk -F'\t' -v p="$path" '$3==p{print $4}' "$CACHE")
  printf 'Remove worktree %s? [y/N] ' "$path"
  read -r ans; [ "$ans" = y ] || [ "$ans" = Y ] || { echo "aborted"; return 1; }
  [ -z "$ws" ] && die "not open as a workspace; open it first (dev herdr)"
  ssh "$REMOTE" "$HERDR worktree remove --workspace '$ws'" >/dev/null && echo "dev: removed $path"
}

# --- env -------------------------------------------------------------------
# Values never appear on a command line: argv is world-readable via ps, and the
# agents on the box run as the same user. Everything moves over stdin, and the
# picker shows key names and value lengths only.

ENV_MERGE_PY='
import os, re, sys, time
target = os.environ["TARGET"]
incoming = {}
for line in sys.stdin.read().splitlines():
    k, sep, v = line.partition("=")
    if sep and k.strip():
        incoming[k.strip()] = v
try:
    lines = open(target).read().splitlines()
except FileNotFoundError:
    lines = []
if lines:
    bak = target + ".bak." + time.strftime("%Y%m%d%H%M%S")
    open(bak, "w").write("\n".join(lines) + "\n")
    os.chmod(bak, 0o600)
seen, out = set(), []
for line in lines:
    m = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=", line)
    if m and m.group(1) in incoming:
        out.append(m.group(1) + "=" + incoming[m.group(1)])
        seen.add(m.group(1))
    else:
        out.append(line)
added = [k for k in incoming if k not in seen]
if added:
    if out and out[-1].strip():
        out.append("")
    out.append("# added by dev env push " + time.strftime("%Y-%m-%d"))
    out += [k + "=" + incoming[k] for k in added]
open(target, "w").write("\n".join(out) + "\n")
os.chmod(target, 0o600)
print("updated %d, added %d, backup %s" % (len(seen), len(added),
      "yes" if lines else "none (new file)"))
'

env_keys_local() {
  python3 -c '
import re, sys
for line in open(sys.argv[1], errors="replace"):
    m = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$", line.rstrip("\n"))
    if not m:
        continue
    k, v = m.group(1), m.group(2).strip().strip("\"'"'"'")
    print("%s\t%s" % (k, "empty" if not v else "%s (%d chars)" % ("*" * min(len(v), 8), len(v))))
' "$1"
}

cmd_env() {
  local sub="push"
  case "${1:-}" in ls|diff|push) sub="$1"; shift ;; esac
  local from="" query="" target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="$2"; shift 2 ;;
      -p)     target="$2"; shift 2 ;;
      *)      query="$1"; shift ;;
    esac
  done
  if [ -z "$target" ]; then
    refresh_cache
    resolve "$query" || return 1
    target="$REPLY_PATH"
  fi
  local repo; repo=$(basename "$target")

  case "$sub" in
    ls)
      ssh "$REMOTE" "sed -n 's/^\s*\([A-Za-z_][A-Za-z0-9_]*\)\s*=.*/\1/p' '$target/.env' 2>/dev/null" |
        sed 's/^/  /'
      ;;
    diff)
      [ -z "$from" ] && from="$HOME/dev/$repo/.env"
      [ -f "$from" ] || die "no local source: $from"
      local here there
      here=$(env_keys_local "$from" | cut -f1 | sort)
      there=$(ssh "$REMOTE" "sed -n 's/^\s*\([A-Za-z_][A-Za-z0-9_]*\)\s*=.*/\1/p' '$target/.env' 2>/dev/null" | sort)
      echo "local only  ($from):";        comm -23 <(echo "$here") <(echo "$there") | sed 's/^/  + /'
      echo "remote only ($target/.env):"; comm -13 <(echo "$here") <(echo "$there") | sed 's/^/  - /'
      ;;
    push)
      need fzf
      [ -z "$from" ] && from="$HOME/dev/$repo/.env"
      if [ ! -f "$from" ]; then
        from=$(find "$HOME/dev" -maxdepth 2 -name '.env*' -not -path '*/node_modules/*' 2>/dev/null |
               fzf --prompt='source .env> ' --reverse --height=40%) || return 1
      fi
      [ -f "$from" ] || die "no source file"

      local keys
      keys=$(env_keys_local "$from" | awk -F'\t' '{printf "%-32s %s\n", $1, $2}' |
             fzf --multi --prompt='vars to copy> ' --reverse --height=50% \
                 --header="$from  →  $REMOTE:$target/.env    tab = select, enter = push" |
             awk '{print $1}') || return 1
      [ -z "$keys" ] && { echo "nothing selected"; return 0; }

      local n; n=$(printf '%s\n' "$keys" | grep -c .)
      printf 'Copy %d var(s) to %s:%s/.env? [y/N] ' "$n" "$REMOTE" "$target"
      read -r ans; [ "$ans" = y ] || [ "$ans" = Y ] || { echo "aborted"; return 1; }

      ssh "$REMOTE" "TARGET='$target/.env' python3 -c \"\$(printf %s '$(printf '%s' "$ENV_MERGE_PY" | base64)' | base64 -d)\"" \
        < <(while IFS= read -r k; do
              [ -z "$k" ] && continue
              grep -m1 -E "^[[:space:]]*$k[[:space:]]*=" "$from" | sed 's/^[[:space:]]*//'
            done <<< "$keys")
      ;;
  esac
}

# --- ask -------------------------------------------------------------------
cmd_ask() {
  local agent="claude" query="" question="" path=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent|-a) agent="$2"; shift 2 ;;
      -w)         query="$2"; shift 2 ;;
      -p)         path="$2"; shift 2 ;;
      *)          question="${question:+$question }$1"; shift ;;
    esac
  done

  local one
  case "$agent" in
    claude) one='claude -p "$P"' ;;
    gemini) one='gemini -p "$P"' ;;
    grok)   one='grok -p "$P"' ;;
    codex)  one='codex exec --skip-git-repo-check "$P"' ;;
    *)      die "unknown agent: $agent (claude|codex|gemini|grok)" ;;
  esac

  if [ -z "$path" ]; then
    refresh_cache
    resolve "$query" || return 1
    path="$REPLY_PATH"
  fi

  if [ -z "$question" ]; then
    remote_tty "cd '$path' && export PATH=\$HOME/.local/bin:\$PATH && exec $agent"
  fi
  printf '%s' "$question" |
    ssh "$REMOTE" "cd '$path' && export PATH=\$HOME/.local/bin:\$PATH && P=\$(cat) && $one"
}

# --- main ------------------------------------------------------------------
main() {
  case "${1:-}" in
    _pane)     shift; cmd_pane "$@" ;;          # internal: fzf preview
    ls|list)   shift; cmd_ls "$@" ;;
    ps)        shift; cmd_ps "$@" ;;
    new|add)   shift; cmd_new "$@" ;;
    env)       shift; cmd_env "$@" ;;
    ask|\?)    shift; cmd_ask "$@" ;;
    rm|remove) shift; refresh_cache; resolve "${1:-}" && rm_worktree "$REPLY_PATH" ;;
    code)      shift; refresh_cache; resolve "${1:-}" && open_code "$REPLY_PATH" ;;
    herdr|h)   shift; refresh_cache; resolve "${1:-}" && open_herdr "$REPLY_PATH" ;;
    preview|p) shift; refresh_cache; resolve "${1:-}" && open_preview "$REPLY_PATH" "$REPLY_PORTS" ;;
    -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)         browse "${1:-}" ;;
  esac
}

main "$@"
