#!/usr/bin/env bash
# tailnet-hosts — generate SSH config entries for Linux hosts on the tailnet.
#
# Writes a managed block to ~/.ssh/config.d/tailnet and makes sure ~/.ssh/config
# includes it. Termius (desktop) imports from ~/.ssh/config, and a Termius
# account then syncs those hosts to your phone and tablet — so this is the
# discovery step for every device, not just the Mac.
#
#   tailnet-hosts            regenerate
#   tailnet-hosts --dry-run  print what would be written
#   tailnet-hosts --user X   login user for generated hosts (default: exedev)
#
# Phones, tablets and this machine are skipped: only Linux peers are SSH targets.

set -euo pipefail

OUT="${TAILNET_HOSTS_FILE:-$HOME/.ssh/config.d/tailnet}"
USER_NAME="exedev"
DRY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1; shift ;;
    --user)    USER_NAME="$2"; shift 2 ;;
    --out)     OUT="$2"; shift 2 ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "tailnet-hosts: unknown option $1" >&2; exit 1 ;;
  esac
done

command -v tailscale >/dev/null || { echo "tailnet-hosts: tailscale CLI not found" >&2; exit 1; }

block=$(tailscale status --json | USER_NAME="$USER_NAME" python3 -c '
import json, os, sys, re

d = json.load(sys.stdin)
user = os.environ["USER_NAME"]
suffix = d.get("MagicDNSSuffix", "")
peers = (d.get("Peer") or {}).values()

rows = []
for p in peers:
    if (p.get("OS") or "").lower() != "linux":
        continue                                  # phones and tablets are not targets
    host = (p.get("HostName") or "").strip()
    if not host:
        continue
    ips = [a for a in (p.get("TailscaleIPs") or []) if ":" not in a]
    if not ips:
        continue
    alias = re.sub(r"[^A-Za-z0-9._-]", "-", host)
    fqdn = "%s.%s" % (host, suffix) if suffix else host
    rows.append((alias, ips[0], fqdn, bool(p.get("Online"))))

rows.sort()
if not rows:
    sys.exit("tailnet-hosts: no Linux peers found on the tailnet")

out = []
for alias, ip, fqdn, online in rows:
    out.append("# %s%s" % (fqdn, "" if online else "   (offline at last scan)"))
    out.append("Host %s" % alias)
    out.append("  HostName %s" % ip)
    out.append("  User %s" % user)
    out.append("  ServerAliveInterval 30")
    out.append("  ServerAliveCountMax 6")
    out.append("")
print("\n".join(out).rstrip())
')

header="# managed by tailnet-hosts — regenerate, do not hand-edit
# hosts discovered from the tailnet; IPs are stable per device"

if [ "$DRY" = 1 ]; then
  printf '%s\n\n%s\n' "$header" "$block"
  printf '\n-- would write to %s\n' "$OUT"
  exit 0
fi

mkdir -p "$(dirname "$OUT")"
printf '%s\n\n%s\n' "$header" "$block" > "$OUT"
chmod 600 "$OUT"

# ssh_config takes the FIRST value for any keyword, so the Include has to come
# before any Host block that might also match.
cfg="$HOME/.ssh/config"
inc="Include ~/.ssh/config.d/*"
if [ -f "$cfg" ] && ! grep -qF "config.d/*" "$cfg"; then
  cp "$cfg" "$cfg.bak.$(date +%Y%m%d%H%M%S)"
  printf '%s\n\n%s' "$inc" "$(cat "$cfg")" > "$cfg.new" && mv "$cfg.new" "$cfg"
  echo "tailnet-hosts: added '$inc' to $cfg (backup alongside)"
fi

n=$(grep -c '^Host ' "$OUT" || true)
echo "tailnet-hosts: wrote $n host(s) to $OUT"
grep '^Host ' "$OUT" | sed 's/^Host /  /'
