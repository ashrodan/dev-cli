#!/usr/bin/env bash
# dev — worktree-first navigator for the herdr dev box.
#
#   dev -P|--profile [command...]       pick an exe.dev SSH profile and box
#   dev [-H host] [-B box] [command...] use a host; select or provision a box
#   dev              browse worktrees
#                      ↑ ↓     move, preview updates live
#                      enter copy herdr login command
#                      →     open the action menu     esc quit
#                      ctrl-o  VS Code     ctrl-h  herdr
#                      ctrl-s  herdr, in a chosen or new session
#                      ctrl-p  preview     ctrl-e  env push
#                      ctrl-n  new task workspace
#                      ctrl-r  re-scan now; the list also re-scans itself
#                              every DEV_REFRESH_SECS seconds (0 disables)
#   dev ls           list every worktree, with any servers it is running
#   dev ps           list listening servers on the box, with preview URLs
#   dev fleet          monitor Herdr and unmanaged sessions across every box
#   dev new [repo] <branch> [--base ref]
#   dev rm   [query]
#   dev code [query]                 open in VS Code
#   dev herdr [query]                attach the herdr session there
#   dev copy [query]                copy the herdr login command
#   dev pr [query]                    create/open its draft PR with local gh auth
#   dev github setup|status           configure/check tokenless gh on the box
#   dev task                         select project + PR, Linear issue, or prompt
#   dev herdr -S [query]             ...picking the session first
#   dev herdr -s NAME [query]        ...in a named session (created if new)
#   dev sessions                     list herdr sessions on the box
#   dev preview [query]              open a running server in the browser
#   dev env push|ls|diff [query] [--from FILE]
#   dev ask [-a agent] [-w query] [question...]
#   dev box new [name] [owner/repo] [--yes]
#   dev box bootstrap owner/repo
#
# Worktrees are the unit of work. The main checkout is just the worktree that
# happens to hold the primary branch.

set -uo pipefail

REMOTE="${DEV_REMOTE:-dai}"
BOX="${DEV_BOX:-}"
SSH_OVERRIDE_HOST="${DEV_SSH_HOSTNAME:-}"
RHOME="${DEV_REMOTE_HOME:-/home/exedev}"
HERDR="$RHOME/.local/bin/herdr"
WT_ROOT="${DEV_WT_ROOT:-$RHOME/worktrees}"
SESSION="${DEV_SESSION:-default}"
PROXY_HOST="${DEV_PROXY_HOST:-}"
TS_HOST="${DEV_TS_HOST:-}"
PROXY_PORT="${DEV_PROXY_PORT:-8000}"
REFRESH_SECS="${DEV_REFRESH_SECS:-30}"
FZF_FOOTER=""
SCREEN=""

die()  { printf 'dev: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

list_running_boxes() {
  ssh "$REMOTE" ls --json 2>/dev/null | python3 -c '
import json, sys
try:
    vms = json.load(sys.stdin).get("vms", [])
except Exception:
    sys.exit(1)
for vm in vms:
    if vm.get("status") == "running" and vm.get("access", {}).get("shell"):
        name = vm.get("vm_name", "")
        host = vm.get("ssh_host") or vm.get("ssh_dest") or ""
        if name and host:
            print(name + "\t" + host)
'
}

wait_for_box() {
  local name="$1" choices choice attempts=0
  while [ "$attempts" -lt 60 ]; do
    choices=$(list_running_boxes 2>/dev/null || true)
    choice=$(printf '%s\n' "$choices" |
             awk -F'\t' -v box="$name" '$1 == box { print; exit }')
    if [ -n "$choice" ]; then
      printf '%s\n' "$choice"
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 2
  done
  return 1
}

bootstrap_box_agent() {
  ssh_remote "bash -s" <<'REMOTE_EOF'
set -euo pipefail
export HOME=/home/exedev
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

if ! command -v herdr >/dev/null 2>&1; then
  curl -fsSL https://herdr.dev/install.sh | sh
fi
if ! command -v omp >/dev/null 2>&1; then
  sudo npm install -g @oh-my-pi/pi-coding-agent
fi

herdr integration install omp
service=$(mktemp)
cat > "$service" <<'UNIT'
[Unit]
Description=herdr agent runtime (headless server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev
Environment=HOME=/home/exedev
Environment=PATH=/home/exedev/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/exedev/.local/bin/herdr server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT
sudo install -m 0644 "$service" /etc/systemd/system/herdr.service
rm -f "$service"
sudo systemctl daemon-reload
sudo systemctl enable --now herdr.service
systemctl is-active --quiet herdr.service
REMOTE_EOF
}

setup_box_project() {
  local project="$1" name="${BOX:-${SSH_OVERRIDE_HOST%.exe.xyz}}"
  local repo_name integration line dest qdest qurl opened fields pane agent qname qpane

  printf 'dev: installing Herdr and OMP\n'
  bootstrap_box_agent ||
    die "box $name is running but agent setup failed; resume with: dev -H $REMOTE -B $name box bootstrap $project"

  repo_name="${project##*/}"
  line=$(ssh "$REMOTE" integrations list 2>/dev/null |
         awk -v repo="repos=$project" 'index($0, repo) { print; exit }')
  if [ -n "$line" ]; then
    integration="${line%% *}"
    case "$line" in
      *"vm:$name"*) ;;
      *) ssh "$REMOTE" integrations attach "$integration" "vm:$name" ||
           die "could not attach GitHub integration $integration to $name" ;;
    esac
  else
    integration="$repo_name"
    ssh "$REMOTE" integrations add github "--name=$integration" \
      "--repository=$project" "--attach=vm:$name" ||
      die "could not add the GitHub integration for $project"
  fi

  dest="$RHOME/$repo_name"
  printf -v qdest '%q' "$dest"
  printf -v qurl '%q' "https://github.int.exe.xyz/$project.git"
  ssh_remote "
    set -e
    if [ -d $qdest/.git ]; then
      exit 0
    fi
    [ ! -e $qdest ] || {
      printf 'destination exists but is not a git checkout: %s\n' $qdest >&2
      exit 2
    }
    attempt=0
    until git clone $qurl $qdest; do
      attempt=\$((attempt + 1))
      [ \"\$attempt\" -lt 10 ] || exit 3
      sleep 2
    done
  " || die "could not clone $project; resume with: dev -H $REMOTE -B $name box bootstrap $project"

  printf -v qname '%q' "$repo_name"
  opened=$(ssh_remote "$HERDR --session $SESSION worktree open --cwd $qdest --path $qdest --focus") ||
    die "could not open $project in Herdr"
  fields=$(printf '%s' "$opened" | python3 -c '
import json, sys
try:
    root = json.load(sys.stdin).get("result", {}).get("root_pane") or {}
    print((root.get("pane_id") or "") + "\x1f" + (root.get("agent") or ""))
except Exception:
    pass
')
  IFS=$'\037' read -r pane agent <<< "$fields"
  [ -n "$pane" ] || die "Herdr did not return a pane for $project"
  case "$agent" in
    omp) ;;
    "")
      printf -v qpane '%q' "$pane"
      ssh_remote "$HERDR --session $SESSION agent start $qname --kind omp --pane $qpane" ||
        die "repository is ready but OMP did not start; resume with: dev -H $REMOTE -B $name herdr $repo_name"
      ;;
    *) die "repository opened with $agent already running instead of OMP" ;;
  esac
}

provision_box() {
  local name="${1:-${DEV_NEW_BOX_NAME:-}}" project="${2:-${DEV_NEW_BOX_PROJECT:-}}"
  local yes="${3:-${DEV_NEW_BOX_YES:-}}" resolved answer created choice

  resolved=$(ssh -G "$REMOTE" 2>/dev/null |
             awk '$1 == "hostname" { print $2; exit }')
  [ "$resolved" = "exe.dev" ] ||
    die "box provisioning requires an exe.dev lobby profile, not $REMOTE"

  if [ -z "$name" ]; then
    [ -t 0 ] || die "usage: dev -H PROFILE box new NAME OWNER/REPO [--yes]"
    printf 'box name> ' >&2
    IFS= read -r name
  fi
  case "$name" in
    [a-z0-9]*)
      case "$name" in
        *[!a-z0-9-]*) die "box name may contain only lowercase letters, numbers, and hyphens" ;;
        *-) die "box name must end with a lowercase letter or number" ;;
      esac
      ;;
    *) die "box name must start with a lowercase letter or number" ;;
  esac
  if [ -z "$project" ]; then
    project=$(pick_project) || return 1
  fi
  case "$project" in
    */*) ;;
    *) die "project must be OWNER/REPO: $project" ;;
  esac

  if [ "$yes" != "yes" ] && [ "$yes" != "1" ]; then
    [ -t 0 ] || die "box creation requires --yes without an interactive terminal"
    printf 'Create billable box %s, clone %s, and start OMP? [y/N] ' "$name" "$project" >&2
    IFS= read -r answer
    case "$answer" in y|Y|yes|YES) ;; *) return 1 ;; esac
  fi

  printf 'dev: creating %s through %s\n' "$name" "$REMOTE"
  created=$(ssh "$REMOTE" new --json "--name=$name" --tag=tailscale \
            "--comment=dev-cli:$project") ||
    die "exe.dev could not create box $name"
  [ -n "$created" ] || die "exe.dev returned no result for box $name"

  printf 'dev: waiting for shell access\n'
  choice=$(wait_for_box "$name") ||
    die "box $name was created but did not become shell-ready; resume with: dev -H $REMOTE -B $name box bootstrap $project"
  BOX=$(printf '%s' "$choice" | cut -f1)
  SSH_OVERRIDE_HOST=$(printf '%s' "$choice" | cut -f2)

  setup_box_project "$project"
  printf 'dev: %s is ready with %s and OMP\n' "$name" "$project"
}

configure_remote() {
  local resolved choices choice count
  resolved=$(ssh -G "$REMOTE" 2>/dev/null |
             awk '$1 == "hostname" { print $2; exit }')
  [ -n "$resolved" ] || resolved="$REMOTE"

  # An exe.dev account alias (for example `exe-dash`) reaches the lobby rather
  # than a VM. Resolve it to a shell-capable running box while retaining the
  # alias as the SSH destination, so its IdentityFile still selects the account.
  if [ -z "$SSH_OVERRIDE_HOST" ] && [ "$resolved" = "exe.dev" ]; then
    choices=$(list_running_boxes) ||
      die "could not list boxes through SSH profile $REMOTE"

    if [ -n "$BOX" ]; then
      choice=$(printf '%s\n' "$choices" |
               awk -F'\t' -v box="$BOX" '$1 == box || $2 == box { print; exit }')
      [ -n "$choice" ] || die "box $BOX is not a running box in SSH profile $REMOTE"
    elif [ -t 0 ] || [ -n "${DEV_TEST_BOX_PICKER:-}" ]; then
      need fzf
      choice=$({ [ -z "$choices" ] || printf '%s\n' "$choices"
                 printf '+all\tmonitor Herdr and unmanaged sessions on every box\n'
                 printf '+new\tcreate a box, clone a repository, and start OMP\n'
               } |
               fzf --prompt='box> ' --reverse --height=30% --delimiter=$'\t' \
                   --with-nth=1,2 --header='exe.dev boxes') ||
        exit 0
      case "${choice%%	*}" in
        +all)
          BOX="@fleet"
          choice=""
          ;;
        +new)
          provision_box || return 1
          resolved="$SSH_OVERRIDE_HOST"
          choice=""
          ;;
      esac
    else
      [ -n "$choices" ] || die "SSH profile $REMOTE has no running shell-capable boxes"
      count=$(printf '%s\n' "$choices" | awk 'NF { n++ } END { print n + 0 }')
      [ "$count" -eq 1 ] ||
        die "SSH profile $REMOTE has multiple boxes; select one with --box NAME"
      choice="$choices"
    fi

    if [ -n "$choice" ]; then
      BOX=$(printf '%s' "$choice" | cut -f1)
      SSH_OVERRIDE_HOST=$(printf '%s' "$choice" | cut -f2)
      resolved="$SSH_OVERRIDE_HOST"
    fi
  fi

  [ -n "$PROXY_HOST" ] || PROXY_HOST="$resolved"
  if [ -z "$TS_HOST" ]; then
    case "$resolved" in
      *.exe.xyz) TS_HOST="${resolved%.exe.xyz}" ;;
      *)         TS_HOST="$resolved" ;;
    esac
  fi

  # fzf starts the preview as a fresh dev process. Preserve the selected host
  # and its derived URL settings instead of repeating profile discovery.
  export DEV_REMOTE="$REMOTE" DEV_BOX="$BOX" DEV_SSH_HOSTNAME="$SSH_OVERRIDE_HOST"
  export DEV_PROXY_HOST="$PROXY_HOST" DEV_TS_HOST="$TS_HOST"
}

ssh_remote() {
  local -a tty=()
  if [ "${1:-}" = "-t" ]; then
    tty=(-t)
    shift
  fi
  if [ -n "$SSH_OVERRIDE_HOST" ]; then
    ssh "${tty[@]}" -o "HostName=$SSH_OVERRIDE_HOST" "$REMOTE" "$@"
  else
    ssh "${tty[@]}" "$REMOTE" "$@"
  fi
}

ssh_config_aliases() {
  python3 -c '
import glob
import os
import shlex
import sys

root = os.path.abspath(os.path.expanduser(sys.argv[1]))
base = os.path.dirname(root)
seen_files = set()
seen_aliases = set()
aliases = []

def visit(pattern):
    expanded = os.path.expanduser(pattern)
    if not os.path.isabs(expanded):
        expanded = os.path.join(base, expanded)
    for path in sorted(glob.glob(expanded)):
        path = os.path.realpath(path)
        if path in seen_files or not os.path.isfile(path):
            continue
        seen_files.add(path)
        try:
            lines = open(path, errors="replace")
        except OSError:
            continue
        with lines:
            for raw in lines:
                try:
                    fields = shlex.split(raw, comments=True)
                except ValueError:
                    continue
                if not fields:
                    continue
                keyword = fields[0].lower()
                if keyword == "include":
                    for include in fields[1:]:
                        visit(include)
                elif keyword == "host":
                    for alias in fields[1:]:
                        if (alias.startswith("!") or
                                any(char in alias for char in "*?!")):
                            continue
                        if alias not in seen_aliases:
                            seen_aliases.add(alias)
                            aliases.append(alias)

visit(root)
print("\n".join(aliases))
' "${DEV_SSH_CONFIG:-$HOME/.ssh/config}"
}

list_ssh_profiles() {
  local alias config hostname identity
  ssh_config_aliases | while IFS= read -r alias; do
    [ -n "$alias" ] || continue
    config=$(ssh -G "$alias" 2>/dev/null) || continue
    hostname=$(printf '%s\n' "$config" |
               awk '$1 == "hostname" { print $2; exit }')
    [ "$hostname" = "exe.dev" ] || continue
    identity=$(printf '%s\n' "$config" |
               awk '$1 == "identityfile" { print $2; exit }')
    printf '%s\t%s\n' "$alias" "${identity:--}"
  done
}

pick_ssh_profile() {
  need fzf
  local profiles choice
  profiles=$(list_ssh_profiles)
  [ -n "$profiles" ] || die "no exe.dev SSH profiles found in ${DEV_SSH_CONFIG:-$HOME/.ssh/config}"
  choice=$(printf '%s\n' "$profiles" |
           fzf --prompt='profile> ' --reverse --height=30% --delimiter=$'\t' \
               --with-nth=1,2 --header='SSH profile    identity key') || return 1
  printf '%s' "$choice" | cut -f1
}

# --- remote scan -----------------------------------------------------------
# One SSH round trip. Tab separated:
#   1 repo  2 branch  3 path  4 workspace  5 kind  6 ports
#   7 sha   8 when    9 dirty 10 ahead    11 behind  12 subject
scan() {
  ssh_remote "RHOME='$RHOME' HERDR='$HERDR' bash -s" <<'REMOTE_EOF'
set -uo pipefail
export PATH="$RHOME/.local/bin:$PATH"

repos=$(find "$RHOME" -maxdepth 3 -name .git \
        -not -path '*/node_modules/*' -not -path "$RHOME/.*" \
        -printf '%h\n' 2>/dev/null | sort -u)

{
  for repo in $repos; do "$HERDR" worktree list --cwd "$repo" 2>/dev/null; done

  echo '---PORTS---'
  ss -tlnpH 2>/dev/null | while read -r line; do
    addr=$(printf '%s' "$line" | awk '{print $4}')
    port=${addr##*:}; host=${addr%:*}
    pid=$(printf '%s' "$line" | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)
    [ -z "$pid" ] && continue
    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || continue
    cmd=$(tr -d '\0' < "/proc/$pid/comm" 2>/dev/null)
    case "$host" in 127.0.0.1|'[::1]') scope=l ;; *) scope=g ;; esac
    printf '%s\t%s\t%s\t%s\n' "$port" "$scope" "$cwd" "$cmd"
  done

  echo '---GIT---'
  for repo in $repos; do
    git -C "$repo" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}' |
    while read -r wt; do
      sha=$(git -C "$wt" log -1 --format=%h 2>/dev/null)
      when=$(git -C "$wt" log -1 --format=%cr 2>/dev/null)
      subj=$(git -C "$wt" log -1 --format=%s 2>/dev/null | tr '\t|' '  ' | cut -c1-68)
      dirty=$(git -C "$wt" status --porcelain 2>/dev/null | grep -c . || true)
      ab=$(git -C "$wt" rev-list --count --left-right '@{u}...HEAD' 2>/dev/null || printf '0\t0')
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$wt" "$sha" "$when" "$dirty" \
        "$(printf '%s' "$ab" | cut -f2)" "$(printf '%s' "$ab" | cut -f1)" "$subj"
    done
  done
} | python3 -c '
import json, sys

blocks = sys.stdin.read().split("---PORTS---")
wt_lines = blocks[0].splitlines()
rest     = blocks[1] if len(blocks) > 1 else ""
pblock, _, gblock = rest.partition("---GIT---")

servers = [p.split("\t") for p in pblock.splitlines() if p.count("\t") == 3]

meta = {}
for line in gblock.splitlines():
    f = line.split("\t")
    if len(f) == 7:
        meta[f[0]] = f[1:]

worktrees, seen = [], set()
for line in wt_lines:
    line = line.strip()
    if not line:
        continue
    try:
        res = json.loads(line).get("result", {})
    except Exception:
        continue
    repo = res.get("source", {}).get("repo_name", "?")
    for w in res.get("worktrees", []):
        path = w.get("path", "")
        if not path or path in seen:
            continue
        seen.add(path)
        worktrees.append((repo, w.get("branch") or "(detached)", path,
                          w.get("open_workspace_id") or "",
                          "linked" if w.get("is_linked_worktree") else "main"))

for repo, branch, path, ws, kind in sorted(worktrees, key=lambda r: -len(r[2])):
    ports = sorted({p + ("l" if s == "l" else "")
                    for p, s, cwd, _ in servers
                    if cwd == path or cwd.startswith(path.rstrip("/") + "/")})
    m = meta.get(path, ["", "", "0", "0", "0", ""])
    print("\t".join([repo, branch, path, ws, kind, ",".join(ports)] + m))

sys.stderr.write("".join(
    "ORPHAN\t%s\t%s\t%s\t%s\n" % (p, s, c, m)
    for p, s, c, m in servers
    if not any(c == w[2] or c.startswith(w[2].rstrip("/") + "/") for w in worktrees)))
'
REMOTE_EOF
}

# A Herdr server can report workspaces and agent state. Boxes without Herdr
# still expose enough through /proc, tmux, and screen to keep their live
# terminals visible in the fleet list. Raw processes are presence-only: their
# terminal output and idle/blocked state are not recoverable.
scan_unmanaged_sessions() {
  ssh_remote "HERDR='$HERDR' SESSION='$SESSION' bash -s" <<'REMOTE_EOF'
set -uo pipefail

{
  for proc in /proc/[0-9]*; do
    [ -r "$proc/cmdline" ] || continue
    pid=${proc##*/}
    ppid=$(awk '$1 == "PPid:" { print $2; exit }' "$proc/status" 2>/dev/null) || continue
    cwd=$(readlink "$proc/cwd" 2>/dev/null) || continue
    tty=$(readlink "$proc/fd/0" 2>/dev/null || printf '-')
    comm=$(cat "$proc/comm" 2>/dev/null) || continue
    args=$(tr '\000\t\r\n' '    ' < "$proc/cmdline" 2>/dev/null | cut -c1-240)
    printf 'PROC\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$pid" "$ppid" "$cwd" "$tty" "$comm" "$args"
  done

  if command -v tmux >/dev/null 2>&1; then
    tmux list-sessions -F 'TMUX	#{session_name}	#{session_windows}	#{session_attached}	#{pane_current_path}' 2>/dev/null || true
  fi

  if command -v screen >/dev/null 2>&1; then
    screen -ls 2>/dev/null |
      sed -n 's/^[[:space:]]*\([0-9][0-9]*\)\.\([^[:space:]]*\)[[:space:]]*(\([^)]*\)).*/SCREEN\t\2\t\1\t\3/p' || true
  fi

  if [ -x "$HERDR" ]; then
    json=$("$HERDR" --session "$SESSION" agent list 2>/dev/null || true)
    [ -z "$json" ] || printf 'HERDR_JSON\t%s\n' "$json"
  fi
} | python3 -c '
import json
import os
import re
import sys

records = [line.rstrip("\n").split("\t", 1) for line in sys.stdin]
processes = {}
other = []
managed_counts = {}
herdr_present = False
for fields in records:
    if fields and fields[0] == "PROC":
        parts = fields[1].split("\t")
        if len(parts) >= 6:
            processes[parts[0]] = {
                "ppid": parts[1], "cwd": parts[2], "tty": parts[3],
                "comm": parts[4], "args": parts[5],
            }
    elif fields and fields[0] == "HERDR_JSON":
        herdr_present = True
        try:
            agents_json = json.loads(fields[1])
        except Exception:
            continue
        for agent in agents_json.get("result", {}).get("agents", []):
            key = (agent.get("agent") or "", agent.get("cwd") or "")
            managed_counts[key] = managed_counts.get(key, 0) + 1
    elif fields:
        other.append([fields[0]] + fields[1].split("\t"))

agents = [
    ("omp", re.compile(r"(^|[/ ])omp([ ]|$)|pi-coding-agent", re.I)),
    ("claude", re.compile(r"(^|[/ ])claude([ ]|$)", re.I)),
    ("codex", re.compile(r"(^|[/ ])codex([ ]|$)", re.I)),
    ("gemini", re.compile(r"(^|[/ ])gemini([ ]|$)|gemini-cli", re.I)),
    ("grok", re.compile(r"(^|[/ ])grok([ ]|$)", re.I)),
    ("opencode", re.compile(r"(^|[/ ])opencode([ ]|$)", re.I)),
    ("hermes", re.compile(r"(^|[/ ])hermes([ ]|$)", re.I)),
    ("shelley", re.compile(r"(^|[/ ])shelley([ ]|$)", re.I)),
    ("copilot", re.compile(r"(^|[/ ])copilot([ ]|$)", re.I)),
]

service_commands = (
    "__omp_worker_daemon_broker",
    " browser-relay ",
    " gateway run",
    " serve -systemd-activation",
)

def under_herdr(pid):
    seen = set()
    while pid and pid != "0" and pid not in seen:
        seen.add(pid)
        proc = processes.get(pid)
        if not proc:
            return False
        if proc["comm"] == "herdr":
            return True
        pid = proc["ppid"]
    return False

def under_mux(pid):
    seen = set()
    while pid and pid != "0" and pid not in seen:
        seen.add(pid)
        proc = processes.get(pid)
        if not proc:
            return False
        if proc["comm"].startswith("tmux") or proc["comm"].startswith("screen"):
            return True
        pid = proc["ppid"]
    return False

candidates = []
for pid, proc in sorted(processes.items(), key=lambda item: int(item[0])):
    if under_herdr(pid) or not proc["tty"].startswith("/dev/"):
        continue
    text = proc["comm"] + " " + proc["args"]
    if any(command in text for command in service_commands):
        continue
    for kind, pattern in agents:
        if pattern.search(text):
            candidates.append((pid, proc, kind))
            break

occupied_ttys = set()
for pid, proc, kind in candidates:
    key = (kind, proc["cwd"])
    occupied_ttys.add(proc["tty"])
    if managed_counts.get(key, 0):
        managed_counts[key] -= 1
        continue
    detail = " ".join(proc["args"].split())[:180]
    print("\t".join(["agent", kind, pid, proc["cwd"], detail]))

shells = {"bash", "zsh", "fish", "sh", "dash"}
for pid, proc in sorted(processes.items(), key=lambda item: int(item[0])):
    if (herdr_present or proc["comm"] not in shells or
            not proc["tty"].startswith("/dev/") or proc["tty"] in occupied_ttys or
            under_herdr(pid) or under_mux(pid)):
        continue
    occupied_ttys.add(proc["tty"])
    print("\t".join(["shell", proc["comm"], pid, proc["cwd"], proc["tty"]]))

for fields in other:
    if fields[0] == "TMUX" and len(fields) >= 5:
        name, windows, attached, cwd = fields[1:5]
        state = "attached" if attached != "0" else "detached"
        print("\t".join(["tmux", name, name, cwd,
                         "%s, %s window%s" % (state, windows, "" if windows == "1" else "s")]))
    elif fields[0] == "SCREEN" and len(fields) >= 4:
        name, pid, state = fields[1:4]
        print("\t".join(["screen", name, pid, os.path.expanduser("~"), state.lower()]))
'
REMOTE_EOF
}

scan_herdr_sessions() {
  ssh_remote "RHOME='$RHOME' HERDR='$HERDR' SESSION='$SESSION' bash -s" <<'REMOTE_EOF'
set -uo pipefail
[ -x "$HERDR" ] || exit 0
repos=$(find "$RHOME" -maxdepth 3 -name .git \
        -not -path '*/node_modules/*' -not -path "$RHOME/.*" \
        -printf '%h\n' 2>/dev/null | sort -u)
for repo in $repos; do
  "$HERDR" --session "$SESSION" worktree list --cwd "$repo" 2>/dev/null
done | python3 -c '
import json
import sys

seen = set()
for line in sys.stdin:
    try:
        result = json.loads(line).get("result", {})
    except Exception:
        continue
    repo = result.get("source", {}).get("repo_name") or "?"
    for worktree in result.get("worktrees", []):
        workspace = worktree.get("open_workspace_id") or ""
        path = worktree.get("path") or ""
        if not workspace or not path or workspace in seen:
            continue
        seen.add(workspace)
        branch = worktree.get("branch") or "(detached)"
        print("\t".join([repo, workspace, path, branch]))
'
REMOTE_EOF
}

# Tab separated:
#   1 box  2 ssh host  3 type  4 name  5 target  6 path  7 detail
#   8 Herdr workspace  9 ports
fleet_scan() {
  local choices tmp index=0 pids="" pid file box host
  choices=$(list_running_boxes) ||
    die "could not list boxes through SSH profile $REMOTE"
  [ -n "$choices" ] || die "SSH profile $REMOTE has no running shell-capable boxes"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/dev-fleet.XXXXXX")

  while IFS=$'\t' read -r box host; do
    [ -n "$box" ] && [ -n "$host" ] || continue
    index=$((index + 1))
    file="$tmp/$index"
    (
      printf '%s\t%s\tbox\tonline\t%s\t%s\t%s\t\t\n' \
        "$box" "$host" "$box" "$RHOME" "$host"
      BOX="$box"
      SSH_OVERRIDE_HOST="$host"
      scan_herdr_sessions 2>/dev/null |
        awk -F'\t' -v OFS='\t' -v box="$box" -v host="$host" '
          NF >= 4 { print box, host, "herdr", $1, $2, $3, $4, $2, "" }
        '
      scan_unmanaged_sessions 2>/dev/null |
        awk -F'\t' -v OFS='\t' -v box="$box" -v host="$host" '
          NF >= 5 { print box, host, $1, $2, $3, $4, $5, "", "" }
        '
    ) > "$file" &
    pid=$!
    pids="${pids:+$pids }$pid"
  done <<< "$choices"

  for pid in $pids; do wait "$pid" || true; done
  for file in "$tmp"/*; do [ -f "$file" ] && cat "$file"; done
  rm -rf "$tmp"
}

fleet_fmt() {
  awk -F'\t' 'BEGIN { OFS="\t" }
    {
      if ($3 == "box") {
        row = sprintf("\033[2m%-18s  online\033[0m", $1)
      } else if ($3 == "herdr") {
        row = sprintf("%-18s  \033[32m● herdr\033[0m  %-12s  %-28s  %s",
                      $1, $4, $7, $6)
      } else if ($3 == "agent") {
        row = sprintf("%-18s  \033[33m◆ agent\033[0m  %-12s  pid %-7s  %s",
                      $1, $4, $5, $6)
      } else {
        row = sprintf("%-18s  \033[36m■ %-6s\033[0m %-12s  %-18s  %s",
                      $1, $3, $4, $7, $6)
      }
      print row, $1, $2, $3, $4, $5, $6, $7, $8, $9
    }'
}

cmd_fleet_rows() {
  fleet_scan | fleet_fmt
}

cmd_fleet_ls() {
  cmd_fleet_rows | cut -f1
}

select_fleet_target() {
  BOX="$1"
  SSH_OVERRIDE_HOST="$2"
  PROXY_HOST="$2"
  case "$2" in
    *.exe.xyz) TS_HOST="${2%.exe.xyz}" ;;
    *)         TS_HOST="$2" ;;
  esac
  export DEV_BOX="$BOX" DEV_SSH_HOSTNAME="$SSH_OVERRIDE_HOST"
  export DEV_PROXY_HOST="$PROXY_HOST" DEV_TS_HOST="$TS_HOST"
}

fleet_browse() {
  need fzf
  local out line box host kind name target path workspace command qtarget qpath self
  local -a refresh=()
  printf -v self '%q' "$0"
  [ "$REFRESH_SECS" -gt 0 ] 2>/dev/null &&
    refresh=(--bind "load:reload-sync(sleep $REFRESH_SECS; $self _fleet_rows)")
  while true; do
    out=$(cmd_fleet_rows |
          fzf --ansi --reverse --height=100% --prompt='fleet> ' \
              --delimiter=$'\t' --with-nth=1 \
              --header="All boxes — enter opens; refreshes every ${REFRESH_SECS}s" \
              "${refresh[@]}" --bind "ctrl-r:reload-sync($self _fleet_rows)" \
              --expect=enter) || break
    line=$(printf '%s\n' "$out" | sed -n 2p)
    [ -n "$line" ] || break
    box=$(printf '%s' "$line" | cut -f2)
    host=$(printf '%s' "$line" | cut -f3)
    kind=$(printf '%s' "$line" | cut -f4)
    name=$(printf '%s' "$line" | cut -f5)
    target=$(printf '%s' "$line" | cut -f6)
    path=$(printf '%s' "$line" | cut -f7)
    workspace=$(printf '%s' "$line" | cut -f9)
    select_fleet_target "$box" "$host"
    printf -v qpath '%q' "$path"
    case "$kind" in
      herdr)
        printf -v qtarget '%q' "$workspace"
        ssh_remote "$HERDR --session $SESSION workspace focus $qtarget" >/dev/null 2>&1 || true
        remote_tty "$HERDR --session $SESSION"
        ;;
      tmux)
        printf -v qtarget '%q' "$target"
        remote_tty "tmux attach-session -t $qtarget"
        ;;
      screen)
        printf -v qtarget '%q' "$target"
        remote_tty "screen -r $qtarget"
        ;;
      agent|shell)
        screen_wipe
        printf 'dev: %s pid %s is running outside Herdr and cannot be reattached; opening a shell in %s\n' \
          "$name" "$target" "$path"
        remote_tty "cd $qpath && exec \${SHELL:-/bin/bash} -l"
        ;;
      box)
        remote_tty "cd $qpath 2>/dev/null || cd; exec \${SHELL:-/bin/bash} -l"
        ;;
    esac
  done
}

url_for() {
  local p="${1%l}"
  if [ "${1: -1}" = l ]; then printf 'http://127.0.0.1:%s/\n' "$p"
  elif [ "$p" = "$PROXY_PORT" ]; then printf 'https://%s/\n' "$PROXY_HOST"
  elif [ "$p" -ge 3000 ] 2>/dev/null && [ "$p" -le 9999 ]; then printf 'https://%s:%s/\n' "$PROXY_HOST" "$p"
  else printf 'http://%s:%s/\n' "$TS_HOST" "$p"; fi
}

fmt() {
  awk -F'\t' '{
    mark  = ($4 == "" ? "  " : "\033[32m●\033[0m ")
    srv   = ($6 == "" ? "        " : sprintf("\033[36m▶ %-6s\033[0m", $6))
    dirty = ($9 + 0 > 0 ? sprintf("\033[33m*%-3s\033[0m", $9) : "    ")
    printf "%s%-13s  \033[1m%-34s\033[0m %s %s %s\n", mark, $1, $2, dirty, srv, $3
  }'
}

# Shortcut captions: bold key, dim caption, three spaces between pairs.
keycaps() {
  local out="" cap
  while [ $# -ge 2 ]; do
    printf -v cap '\033[1m%s\033[0m \033[2m%s\033[0m' "$1" "$2"
    out="${out:+$out   }$cap"
    shift 2
  done
  printf '%s' "$out"
}

# fzf grew --footer in 0.62. Probe the option rather than parse a version, and
# fall back to a header full of shortcuts on older builds.
fzf_has_footer() {
  if [ -z "$FZF_FOOTER" ]; then
    FZF_FOOTER=no
    fzf --footer=x --version >/dev/null 2>&1 </dev/null && FZF_FOOTER=yes
  fi
  [ "$FZF_FOOTER" = yes ]
}

# tput measures its own stdout, which is a pipe inside $( ), so it reports the
# terminfo default instead of the terminal that is there. Ask the tty directly.
term_size() {
  local size
  size=$( { stty size </dev/tty; } 2>/dev/null || true )
  case "$size" in
    [0-9]*' '[0-9]*) printf '%s' "$size" ;;
    *)               printf '24 80' ;;
  esac
}

# The browser draws on the alternate screen, so a menu can be laid over the list
# as a modal and quitting hands the shell back exactly as it was found. Anything
# that writes to the terminal wipes the frame first rather than printing on top
# of it. Outside the browser every one of these is a no-op.
screen_enter() {
  [ -t 1 ] || return 0
  SCREEN=1
  screen_write '\033[?1049h\033[H'
}
screen_leave() { [ -n "$SCREEN" ] || return 0; SCREEN=""; screen_write '\033[?1049l'; }
screen_wipe()  { [ -n "$SCREEN" ] || return 0; screen_write '\033[H\033[2J'; }
screen_home()  { [ -n "$SCREEN" ] || return 0; screen_write '\033[H'; }
# pick() and the pickers run inside $( ), where stdout is a pipe, so escapes have
# to go to the terminal explicitly.
screen_write() { printf "$1" >/dev/tty 2>/dev/null || true; }

# Every menu the browser opens appears in the same place — a panel over the
# bottom-right of the list, under where the preview pane was — so the list it
# belongs to stays on screen behind it. `panel LABEL [key caption]...` fills in
# the fzf arguments. Away from the browser there is no frame to lay it over, so
# the picker stays inline.
CORNER=()
corner_window() {
  local size rows cols height top left
  if [ -z "$SCREEN" ]; then
    CORNER=(--height=~55% --border=rounded --border-label=" $1 " --border-label-pos=3)
    return 0
  fi
  size=$(term_size); rows="${size%% *}"; cols="${size#* }"
  height=18
  [ "$height" -gt "$rows" ] && height="$rows"
  [ "$height" -lt 6 ] && height=6
  top=$(( rows - height + 1 )); [ "$top" -lt 1 ] && top=1
  left=$(( cols * 48 / 100 )); [ "$left" -lt 0 ] && left=0
  # Height mode draws from the cursor down, so park the cursor on the row the
  # panel should start at. --no-clear leaves the panel up until the list paints
  # over it, which is what makes backing out of a menu flicker-free.
  screen_write "\\033[${top};1H"
  CORNER=(--height="$height" "--margin=0,0,0,$left" --no-clear
          --border=rounded --border-label=" $1 " --border-label-pos=3)
}

panel() {
  local label="$1"
  shift
  corner_window "$label"
  [ $# -ge 2 ] && fzf_has_footer &&
    CORNER+=(--footer="$(keycaps "$@")" --footer-border=line)
  return 0
}

# Internal: the shortcut rows. fzf gives the footer the width of the list, not of
# the window, so the captions are packed to the pane that is actually there and
# repacked when the terminal is resized.
cmd_keys() {
  local avail line="" used=0 out="" pair w
  avail=$(( ${FZF_COLUMNS:-80} * 48 / 100 - 3 ))
  [ "$avail" -lt 14 ] && avail=14
  set -- "↑↓" move enter "copy login" "→" actions ctrl-r refresh esc quit \
         ctrl-h herdr ctrl-s session ctrl-o code ctrl-p preview \
         ctrl-n task ctrl-e env
  while [ $# -ge 2 ]; do
    w=$(( ${#1} + 1 + ${#2} ))
    pair=$(keycaps "$1" "$2")
    if [ -z "$line" ]; then
      line="$pair"; used="$w"
    elif [ $(( used + 3 + w )) -le "$avail" ]; then
      line="$line   $pair"; used=$(( used + 3 + w ))
    else
      out="$out$line"$'\n'; line="$pair"; used="$w"
    fi
    shift 2
  done
  printf '%s%s\n' "$out" "$line"
}

# --- live preview pane -----------------------------------------------------
# Rendered from the cached scan, so arrowing through the list costs nothing.
cmd_pane() {
  local path="$1" cache="${DEV_CACHE:-}"
  [ -n "$cache" ] && [ -f "$cache" ] || return 0
  # Tab is an IFS *whitespace* character, so `IFS=$'\t' read` collapses runs of
  # tabs and drops empty fields — a row with no open workspace or no listening
  # ports would shift every later field left and render nonsense. \037 is not
  # whitespace, so each occurrence delimits exactly one field.
  awk -F'\t' -v p="$path" '$3==p' "$cache" | tr '\t' '\037' |
  while IFS=$'\037' read -r repo branch wpath ws kind ports sha when dirty ahead behind subject; do
    printf '\033[1;37m%s\033[0m  \033[2m%s\033[0m\n\n' "$repo" "$kind"
    printf '  \033[2mbranch\033[0m   \033[1m%s\033[0m\n' "$branch"
    printf '  \033[2mpath\033[0m     %s\n' "$wpath"
    [ -n "$sha" ] && printf '  \033[2mhead\033[0m     %s  \033[2m%s\033[0m\n           %s\n' "$sha" "$when" "$subject"

    printf '\n'
    if [ "${dirty:-0}" -gt 0 ] 2>/dev/null; then
      printf '  \033[33m● %s uncommitted file(s)\033[0m\n' "$dirty"
    else
      printf '  \033[32m● clean\033[0m\n'
    fi
    [ "${ahead:-0}" -gt 0 ] 2>/dev/null  && printf '  \033[36m↑ %s ahead of upstream\033[0m\n' "$ahead"
    [ "${behind:-0}" -gt 0 ] 2>/dev/null && printf '  \033[35m↓ %s behind upstream\033[0m\n' "$behind"
    [ -n "$ws" ] && printf '  \033[32m● herdr workspace %s open\033[0m\n' "$ws"

    if [ -n "$ports" ]; then
      printf '\n  \033[1mserving\033[0m\n'
      for p in $(printf '%s' "$ports" | tr ',' ' '); do
        if [ "${p: -1}" = l ]; then
          printf '    %-6s \033[31mlocalhost-bound, not reachable\033[0m\n' "${p%l}"
        else
          printf '    %-6s \033[4m%s\033[0m\n' "$p" "$(url_for "$p")"
        fi
      done
    fi
  done
}

# --- actions ---------------------------------------------------------------
open_code() {
  need code
  screen_wipe
  local code_remote="$REMOTE" candidate
  if [ -n "$SSH_OVERRIDE_HOST" ]; then
    candidate=$(ssh -G "$BOX" 2>/dev/null |
                awk '$1 == "hostname" { print $2; exit }')
    if [ "$candidate" = "$SSH_OVERRIDE_HOST" ]; then
      code_remote="$BOX"
    else
      code_remote="$SSH_OVERRIDE_HOST"
    fi
  fi
  code --remote "ssh-remote+$code_remote" "$1" &&
    printf 'dev: opened %s in VS Code\n' "$1"
}

clipboard_write() {
  if command -v pbcopy >/dev/null 2>&1; then
    pbcopy
  elif command -v wl-copy >/dev/null 2>&1; then
    wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard
  else
    die "no clipboard command found (pbcopy, wl-copy, or xclip)"
  fi
}

herdr_login_command() {
  local path="$1" session="${2:-$SESSION}" command
  printf -v command 'dev -H %q' "$REMOTE"
  if [ -n "$BOX" ]; then
    printf -v command '%s -B %q' "$command" "$BOX"
  fi
  printf -v command '%s herdr -s %q %q' "$command" "$session" "$path"
  printf '%s\n' "$command"
}

copy_herdr_command() {
  local command
  screen_wipe
  command=$(herdr_login_command "$1" "${2:-$SESSION}")
  printf '%s' "$command" | clipboard_write
  printf 'dev: copied %s\n' "$command"
}

pr_handoff_command() {
  local branch="$1" command
  printf -v command 'dev -H %q' "$REMOTE"
  if [ -n "$BOX" ]; then
    printf -v command '%s -B %q' "$command" "$BOX"
  fi
  printf -v command '%s pr %q' "$command" "$branch"
  printf '%s\n' "$command"
}

open_pull_request() {
  need gh
  screen_wipe
  local path="$1" qpath metadata remote_url branch project url base title body range qrange
  printf -v qpath '%q' "$path"
  metadata=$(ssh_remote "git -C $qpath remote get-url origin &&
                         git -C $qpath branch --show-current") ||
    die "could not read GitHub metadata from $path"
  remote_url="${metadata%%$'\n'*}"
  branch="${metadata#*$'\n'}"
  [ "$branch" != "$metadata" ] && [ -n "$branch" ] ||
    die "could not determine the branch for $path"
  project=$(printf '%s' "$remote_url" | python3 -c '
import sys
from urllib.parse import urlparse
url = sys.stdin.read().strip()
if url.startswith("git@") and ":" in url:
    url = "ssh://" + url.replace(":", "/", 1)
parsed = urlparse(url)
path = parsed.path if parsed.scheme else url
parts = [part for part in path.removesuffix(".git").split("/") if part]
print("/".join(parts[-2:]) if len(parts) >= 2 else "")
')
  [ -n "$project" ] || die "could not determine OWNER/REPO from $remote_url"

  url=$(gh pr list --repo "$project" --head "$branch" --state open \
           --limit 1 --json url --jq '.[0].url // ""') ||
    die "could not query pull requests for $project"
  if [ -z "$url" ]; then
    base=$(gh repo view "$project" --json defaultBranchRef --jq '.defaultBranchRef.name') ||
      die "could not determine the default branch for $project"
    [ -n "$base" ] || die "GitHub did not return a default branch for $project"
    title=$(ssh_remote "git -C $qpath log -1 --format=%s") ||
      die "could not read the latest commit title from $path"
    [ -n "$title" ] || die "the task branch has no commit title"
    range="origin/$base..HEAD"
    printf -v qrange '%q' "$range"
    body=$(ssh_remote "git -C $qpath log --reverse --format='- %s%n%n%b' $qrange") ||
      die "could not build the PR body from $range"
    [ -n "$body" ] || body="$title"
    printf 'dev: creating draft PR for %s:%s with local GitHub auth\n' "$project" "$branch"
    url=$(gh pr create --draft --repo "$project" --head "$branch" --base "$base" \
             --title "$title" --body "$body") ||
      die "could not create a draft PR. Confirm the branch is pushed and local gh auth can access $project"
  else
    printf 'dev: found existing PR for %s:%s\n' "$project" "$branch"
  fi
  printf 'dev: opening %s\n' "$url"
  open "$url"
}

github_cli_status() {
  local actor
  actor=$(ssh_remote "export PATH=\$HOME/.local/bin:\$PATH
    gh api graphql -f query='{ viewer { login } }' --jq .data.viewer.login") ||
    die "remote gh could not use the exe.dev GitHub integration; run: dev github setup"
  [ -n "$actor" ] || die "GitHub integration returned an empty API actor"
  printf 'dev: remote gh actor: %s\n' "$actor"
}

github_cli_setup() {
  local payload qpayload
  payload=$(printf '%s\n' \
    '#!/usr/bin/env sh' \
    'export GH_HOST="${GH_HOST:-github.int.exe.xyz}"' \
    'exec /bin/gh "$@"' |
    base64 | tr -d '\n')
  printf -v qpayload '%q' "$payload"
  ssh_remote "
    [ -x /bin/gh ] || { printf 'gh is not installed at /bin/gh\n' >&2; exit 1; }
    mkdir -p \$HOME/.local/bin
    printf %s $qpayload | base64 -d > \$HOME/.local/bin/gh
    chmod 0755 \$HOME/.local/bin/gh
  " || die "could not install the remote gh wrapper"
  printf 'dev: installed tokenless gh wrapper on %s\n' "${BOX:-$REMOTE}"
  github_cli_status
}

cmd_github() {
  case "${1:-status}" in
    setup) github_cli_setup ;;
    status) github_cli_status ;;
    *) die "usage: dev github setup|status" ;;
  esac
}

# --- herdr sessions --------------------------------------------------------
# A session is a whole independent herdr: its own socket, its own workspaces.
# Tabs and workspaces are for multitasking inside one context; a second session
# is for work you want isolated — a spike, a demo, something disposable.
sessions_list() {
  ssh_remote "$HERDR session list --json 2>/dev/null" |
  python3 -c 'import json,sys
try: d = json.load(sys.stdin)
except Exception: sys.exit(0)
for x in d.get("sessions", []):
    print("%s\t%s\t%s" % (x.get("name",""),
                           "running" if x.get("running") else "stopped",
                           "default" if x.get("default") else ""))' 2>/dev/null
}

# Prints the chosen session name on stdout; fails if the user backs out.
pick_session() {
  need fzf
  local choice name
  panel sessions enter attach esc cancel
  choice=$({ sessions_list | awk -F'\t' 'NF{printf "%-20s %-8s %s\n", $1, $2, $3}'
             printf '%-20s %s\n' "+new" "start a fresh, isolated session"
           } | fzf --prompt='session> ' --reverse "${CORNER[@]}" \
                   --header='each session has its own workspaces') || return 1
  name=$(printf '%s' "$choice" | awk '{print $1}')
  if [ "$name" = "+new" ]; then
    printf 'name for the new session: ' >&2
    read -r name || return 1
    # session names become directory names on the box
    name=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//; s/-*$//')
    [ -n "$name" ] || { echo "dev: empty session name" >&2; return 1; }
  fi
  [ -n "$name" ] || return 1
  printf '%s\n' "$name"
}

# --- terminal hygiene ------------------------------------------------------
# A dropped SSH leaves the *remote* TUI's modes set on *our* terminal: alt
# screen, hidden cursor, mouse reporting, bracketed paste, application keypad.
# herdr undoes these on a clean detach (prefix+q), but a connection that dies
# never gets the chance — which is why the local terminal misbehaves afterwards.
# Always hand the terminal back in a known state.
term_restore() {
  [ -t 1 ] || return 0
  printf '\033[?1049l\033[?25h\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?2004l\033[?7h\033[?1l\033>\033(B\033[m'
  stty sane 2>/dev/null || true
}

# Run an interactive remote command and exit, restoring the terminal either way.
# Replaces a bare `exec ssh`, which leaves no opportunity to clean up.
remote_tty() {
  screen_wipe
  ssh_remote -t "$1"
  local rc=$?
  term_restore
  exit $rc
}

open_herdr() {
  local path="$1" session="${2:-$SESSION}" ws
  # Socket-API calls are per-session, so they must be scoped the same way the
  # attach is. A session that does not exist yet simply returns nothing here —
  # we attach anyway and it gets created empty.
  ws=$(ssh_remote "$HERDR --session $session worktree open --path '$path' 2>/dev/null" |
       python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("result",{}).get("workspace_id","") or "")
except Exception: print("")' 2>/dev/null)
  [ -n "$ws" ] && ssh_remote "$HERDR --session $session workspace focus $ws" >/dev/null 2>&1
  remote_tty "$HERDR --session $session"
}

open_shell() { remote_tty "cd '$1' && exec \$SHELL -l"; }

open_preview() {
  local path="$1" ports="$2" choice port url
  if [ -z "$ports" ]; then
    screen_wipe
    printf 'dev: nothing listening in %s\n' "$path" >&2
    printf '     start a server there, and bind 0.0.0.0 not 127.0.0.1\n' >&2
    return 1
  fi
  if [ "$(printf '%s' "$ports" | tr ',' '\n' | grep -c .)" -gt 1 ]; then
    need fzf
    panel ports enter open esc cancel
    choice=$(printf '%s' "$ports" | tr ',' '\n' |
             while read -r p; do printf '%s\t%s\n' "$p" "$(url_for "$p")"; done |
             fzf --prompt='port> ' --reverse "${CORNER[@]}" --delimiter='\t' --with-nth=2) || return 1
    port=$(printf '%s' "$choice" | cut -f1)
  else
    port="$ports"
  fi
  screen_wipe
  if [ "${port: -1}" = l ]; then
    printf 'dev: port %s is bound to 127.0.0.1 on the box, so the proxy cannot see it.\n' "${port%l}" >&2
    printf '     restart it with --host 0.0.0.0\n' >&2
    return 1
  fi
  url=$(url_for "$port")
  printf 'dev: opening %s\n' "$url"
  open "$url"
}

# --- task workspaces -------------------------------------------------------
TASK_ID=""
TASK_TITLE=""
TASK_BRANCH=""
TASK_BASE=""
TASK_PROMPT=""
TASK_NUMBER=""

slugify() {
  printf '%s' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^a-z0-9._-][^a-z0-9._-]*/-/g; s/^-*//; s/-*$//; s/^\(.\{1,56\}\).*$/\1/'
}

local_projects() {
  python3 -c '
import os
import pathlib
import subprocess
import sys
from urllib.parse import urlparse

root = pathlib.Path(os.path.expanduser(sys.argv[1]))
repos = {}

def slug(url):
    url = url.strip()
    if url.startswith("git@") and ":" in url:
        url = "ssh://" + url.replace(":", "/", 1)
    parsed = urlparse(url)
    path = parsed.path if parsed.scheme else url
    parts = [part for part in path.removesuffix(".git").split("/") if part]
    return "/".join(parts[-2:]) if len(parts) >= 2 else ""

def origin_from_config(path):
    marker = path / ".git"
    if marker.is_dir():
        git_dir = marker
    else:
        try:
            pointer = marker.read_text(errors="replace").strip()
        except OSError:
            return ""
        if not pointer.startswith("gitdir:"):
            return ""
        git_dir = pathlib.Path(pointer.split(":", 1)[1].strip())
        if not git_dir.is_absolute():
            git_dir = (path / git_dir).resolve()
        common = git_dir / "commondir"
        if common.is_file():
            try:
                git_dir = (git_dir / common.read_text().strip()).resolve()
            except OSError:
                return ""
    try:
        text = (git_dir / "config").read_text(errors="replace")
    except OSError:
        return ""
    section = ""
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].replace("\"", "").split()
            section = " ".join(section)
            continue
        if section == "remote origin" and line.startswith("url"):
            key, sep, value = line.partition("=")
            if sep and key.strip() == "url":
                return value.strip()
    return ""

# One `git remote get-url` per checkout costs seconds once there are dozens of
# them, and the answer is sitting in the config file.
if root.is_dir():
    for path in root.iterdir():
        if not path.is_dir() or not (path / ".git").exists():
            continue
        remote = origin_from_config(path)
        if not remote:
            try:
                remote = subprocess.check_output(
                    ["git", "-C", str(path), "remote", "get-url", "origin"],
                    text=True, stderr=subprocess.DEVNULL).strip()
            except (OSError, subprocess.CalledProcessError):
                continue
        project = slug(remote)
        if not project:
            continue
        rank = (0 if (path / ".git").is_dir() else 1, len(str(path)))
        current = repos.get(project)
        if current is None or rank < current[0]:
            repos[project] = (rank, str(path))

for project, (_, path) in sorted(repos.items()):
    print(project + "\t" + path)
' "${DEV_PROJECT_ROOT:-$HOME/dev}"
}

# The browser already holds a scan no older than DEV_REFRESH_SECS, so ctrl-n does
# not need to spend another SSH round trip on a blank screen.
box_repo_names() {
  local cache="${DEV_CACHE:-}" repos='$5 == "main" && !seen[$1]++ { print $1 }'
  if [ -n "$cache" ] && [ -s "$cache" ]; then
    awk -F'\t' "$repos" "$cache"
    return 0
  fi
  scan 2>/dev/null | awk -F'\t' "$repos"
}

pick_project() {
  need fzf
  local projects box_repos shortlist choice project
  projects=$(local_projects)
  [ -n "$projects" ] || die "no canonical GitHub projects found under ${DEV_PROJECT_ROOT:-$HOME/dev}"
  box_repos=$(box_repo_names || true)
  shortlist=$(awk -F'\t' '
      NR == FNR { box[$1] = 1; next }
      { name = $1; sub(/^.*\//, "", name); if (box[name]) print }
    ' <(printf '%s\n' "$box_repos") <(printf '%s\n' "$projects"))

  panel projects enter pick esc cancel
  if [ -n "$shortlist" ]; then
    choice=$({ printf '%s\n' "$shortlist"
              printf '+all\tshow all local GitHub projects\n'
            } |
             fzf --prompt='project> ' --reverse "${CORNER[@]}" --delimiter=$'\t' \
                 --with-nth=1,2 --header='Projects already on this box') ||
      return 1
    project=$(printf '%s' "$choice" | cut -f1)
    if [ "$project" != "+all" ]; then
      printf '%s\n' "$project"
      return 0
    fi
  fi

  choice=$(printf '%s\n' "$projects" |
           fzf --prompt='project all> ' --reverse "${CORNER[@]}" --delimiter=$'\t' \
               --with-nth=1,2 --header='All canonical local GitHub projects') ||
    return 1
  printf '%s' "$choice" | cut -f1
}

load_task_metadata() {
  local project="$1" kind="$2" ref="$3" json metadata prompt_slug linear_ref
  case "$project" in
    */*) ;;
    *) die "project must be OWNER/REPO: $project" ;;
  esac

  case "$kind" in
    pr)
      need gh
      json=$(gh pr view "$ref" -R "$project" \
             --json number,title,body,headRefName,baseRefName,url) ||
        die "could not load PR $ref from $project"
      metadata=$(printf '%s' "$json" | python3 -c '
import base64, json, sys
d = json.load(sys.stdin)
n = str(d["number"])
title = d.get("title") or ("PR #" + n)
body = d.get("body") or "(no PR body)"
prompt = """Work on GitHub PR #{number}: {title}
URL: {url}
Base branch: {base}

Treat the existing branch, diff, PR body, and review feedback as the source of truth.
Finish the requested work end to end, verify it, and leave the branch ready to push.

PR body:
{body}""".format(number=n, title=title, url=d.get("url",""),
                 base=d.get("baseRefName",""), body=body)
fields = ["pr-" + n, title, d.get("headRefName") or ("pr/" + n),
          "origin/" + (d.get("baseRefName") or "main"),
          base64.b64encode(prompt.encode()).decode(), n]
print("\x1f".join(fields))
')
      ;;
    linear)
      need linear
      linear_ref="$ref"
      case "$linear_ref" in
        http://linear.app/*/issue/*|https://linear.app/*/issue/*)
          linear_ref="${linear_ref#*/issue/}"
          linear_ref="${linear_ref%%/*}"
          ;;
      esac
      [ -n "$linear_ref" ] || die "could not determine Linear issue identifier from $ref"
      json=$(linear issue view "$linear_ref" --json --no-comments) ||
        die "could not load Linear issue $linear_ref"
      metadata=$(printf '%s' "$json" | python3 -c '
import base64, json, re, sys
d = json.load(sys.stdin)
project = sys.argv[1]
identifier = d.get("identifier") or ""
title = d.get("title") or identifier
fallback = "work/" + re.sub(r"[^a-z0-9]+", "-", (identifier + "-" + title).lower()).strip("-")[:56]
attachment = None
for node in (d.get("attachments") or {}).get("nodes", []):
    meta = node.get("metadata") or {}
    attached_project = (meta.get("repoLogin","") + "/" + meta.get("repoName","")).strip("/")
    if attached_project.lower() == project.lower() and meta.get("branch"):
        attachment = meta
        break
branch = (attachment or {}).get("branch") or d.get("branchName") or fallback
base = "origin/" + ((attachment or {}).get("targetBranch") or "main") if attachment else ""
linked_pr = ("\nLinked PR: " + attachment.get("url","")) if attachment else ""
prompt = """Work on Linear issue {identifier}: {title}
URL: {url}{linked_pr}

Treat this issue as the source of truth. Implement it completely, verify the observable
behavior, and keep the issue scope explicit.

Issue description:
{description}""".format(identifier=identifier, title=title, url=d.get("url",""),
                        linked_pr=linked_pr,
                        description=d.get("description") or "(no description)")
fields = [identifier.lower(), title, branch, base,
          base64.b64encode(prompt.encode()).decode(), identifier]
print("\x1f".join(fields))
' "$project")
      ;;
    prompt)
      prompt_slug=$(slugify "$ref")
      [ -n "$prompt_slug" ] || prompt_slug="task"
      TASK_ID="prompt-$prompt_slug"
      TASK_TITLE="$ref"
      TASK_BRANCH="work/$(date +%Y%m%d)-$prompt_slug"
      TASK_BASE=""
      TASK_PROMPT="Work on this task end to end: $ref"
      TASK_NUMBER=""
      return 0
      ;;
    *)
      die "task type must be pr, linear, or prompt"
      ;;
  esac

  IFS=$'\037' read -r TASK_ID TASK_TITLE TASK_BRANCH TASK_BASE TASK_PROMPT TASK_NUMBER \
    <<< "$metadata"
  TASK_PROMPT=$(printf '%s' "$TASK_PROMPT" | base64 -d)
  [ -n "$TASK_BRANCH" ] || die "task source did not provide a branch"
}

task_bootstrap_command() {
  local project="$1" kind="$2" ref="$3" command
  printf -v command 'dev -H %q' "$REMOTE"
  if [ -n "$BOX" ]; then
    printf -v command '%s -B %q' "$command" "$BOX"
  fi
  printf -v command '%s task run %q %q %q' "$command" "$project" "$kind" "$ref"
  printf '%s\n' "$command"
}

task_plan() {
  [ $# -ge 3 ] || die "usage: dev task plan OWNER/REPO pr|linear|prompt REF"
  local project="$1" kind="$2" ref="$3" command
  screen_wipe
  load_task_metadata "$project" "$kind" "$ref"
  command=$(task_bootstrap_command "$project" "$kind" "$ref")
  printf '%s' "$command" | clipboard_write
  printf 'dev: copied task bootstrap for %s\n%s\n' "$TASK_TITLE" "$command"
}

task_wizard() {
  need fzf
  local project kind choice ref
  project=$(pick_project) || return 1
  panel task enter pick esc cancel
  choice=$(printf '%s\n' \
             'pr      GitHub pull request' \
             'linear  Linear issue' \
             'prompt  free-form task prompt' |
           fzf --prompt='task type> ' --reverse "${CORNER[@]}") || return 1
  kind="${choice%% *}"
  screen_wipe
  case "$kind" in
    pr)     printf 'PR number or URL: ' >&2 ;;
    linear) printf 'Linear issue identifier or URL: ' >&2 ;;
    prompt) printf 'Task prompt: ' >&2 ;;
  esac
  read -r ref || return 1
  [ -n "$ref" ] || return 1
  task_plan "$project" "$kind" "$ref"
}

ensure_remote_repo() {
  local project="$1" repo_name data path task_path qtask common dest url qdest qurl vm integration
  repo_name="${project##*/}"
  data=$(scan 2>/dev/null || true)
  task_path=$(printf '%s\n' "$data" |
              awk -F'\t' -v repo="$repo_name" -v branch="$TASK_BRANCH" '
                $1 == repo && $2 == branch && $5 == "linked" { print $3; exit }
              ')
  if [ -n "$task_path" ]; then
    printf -v qtask '%q' "$task_path"
    common=$(ssh_remote "git -C $qtask rev-parse --path-format=absolute --git-common-dir 2>/dev/null" || true)
    case "$common" in
      */.git)
        printf '%s\n' "${common%/.git}"
        return 0
        ;;
    esac
  fi
  path=$(printf '%s\n' "$data" |
         awk -F'\t' -v repo="$repo_name" -v preferred="$RHOME/$repo_name" '
           $1 == repo && $5 == "main" {
             if ($3 == preferred) { print $3; found = 1; exit }
             if (best == "" || length($3) < length(best)) best = $3
           }
           END { if (!found && best != "") print best }
         ')
  if [ -n "$path" ]; then
    printf '%s\n' "$path"
    return 0
  fi

  dest="$RHOME/$repo_name"
  url="https://github.int.exe.xyz/$project.git"
  printf -v qdest '%q' "$dest"
  printf -v qurl '%q' "$url"
  if ! path=$(ssh_remote "
    if [ -d $qdest/.git ]; then
      printf '%s\n' $qdest
    elif [ -e $qdest ]; then
      printf 'destination exists but is not a git checkout: %s\n' $qdest >&2
      exit 2
    else
      git clone $qurl $qdest >&2 || exit 3
      printf '%s\n' $qdest
    fi
  "); then
    vm="${BOX:-${PROXY_HOST%.exe.xyz}}"
    if [ -n "$SSH_OVERRIDE_HOST" ]; then
      integration=$(ssh "$REMOTE" integrations list 2>/dev/null |
                    awk -v repo="repos=$project" 'index($0, repo) { print $1; exit }')
      if [ -n "$integration" ]; then
        die "could not clone $project. Attach its existing integration: ssh $REMOTE \"integrations attach $integration vm:$vm\""
      fi
      die "could not clone $project. Add its GitHub integration: ssh $REMOTE \"integrations add github --name=$repo_name --repository=$project --attach=vm:$vm\""
    fi
    die "could not clone $project. Use the matching exe.dev lobby profile to attach a GitHub integration for vm:$vm"
  fi
  printf '%s\n' "$path"
}

ensure_task_worktree() {
  local repo="$1" repo_name branch_ref existing branch_exists base path slug
  local qrepo qbranch qref qbase qpath json actual
  repo_name="${repo##*/}"
  branch_ref="refs/heads/$TASK_BRANCH"
  printf -v qrepo '%q' "$repo"
  printf -v qbranch '%q' "$TASK_BRANCH"
  printf -v qref '%q' "$branch_ref"

  existing=$(ssh_remote "git -C $qrepo worktree list --porcelain" |
             awk -v wanted="$branch_ref" '
               /^worktree / { path = substr($0, 10) }
               /^branch / && substr($0, 8) == wanted { print path; exit }')
  if [ -n "$existing" ]; then
    printf '%s\0370\n' "$existing"
    return 0
  fi

  if [ "$TASK_ID" = "pr-$TASK_NUMBER" ]; then
    ssh_remote "git -C $qrepo show-ref --verify --quiet $qref ||
      git -C $qrepo fetch origin pull/$TASK_NUMBER/head:$qref" ||
      die "could not fetch PR #$TASK_NUMBER into $TASK_BRANCH"
  fi

  branch_exists=$(ssh_remote "git -C $qrepo show-ref --verify --quiet $qref && printf yes || true")
  base="$TASK_BASE"
  if [ -z "$base" ]; then
    base=$(ssh_remote "git -C $qrepo symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null ||
                       printf '%s\n' origin/main")
  fi
  slug=$(slugify "$TASK_BRANCH")
  [ -n "$slug" ] || slug=$(slugify "$TASK_ID")
  path="$WT_ROOT/$repo_name/$slug"
  printf -v qpath '%q' "$path"

  if [ -n "$branch_exists" ]; then
    json=$(ssh_remote "$HERDR worktree create --cwd $qrepo --branch $qbranch --path $qpath --focus") ||
      die "worktree create failed for $TASK_BRANCH"
  else
    printf -v qbase '%q' "$base"
    json=$(ssh_remote "$HERDR worktree create --cwd $qrepo --branch $qbranch --base $qbase --path $qpath --focus") ||
      die "worktree create failed for $TASK_BRANCH"
  fi
  actual=$(printf '%s' "$json" | python3 -c '
import json, sys
try:
    result = json.load(sys.stdin).get("result", {})
    print(result.get("worktree", {}).get("path") or result.get("path") or "")
except Exception:
    pass
')
  [ -n "$actual" ] || actual="$path"
  printf '%s\0371\n' "$actual"
}

launch_task_workspace() {
  local path="$1" created="$2" repo="$3" qpath qrepo opened source fields workspace pane agent already
  local name qname qpane qprompt qsession qsource
  printf -v qpath '%q' "$path"
  printf -v qrepo '%q' "$repo"
  printf -v qsession '%q' "$SESSION"
  source=$(ssh_remote "$HERDR --session $qsession worktree list --cwd $qrepo" |
           python3 -c '
import json, sys
try:
    print(json.load(sys.stdin).get("result", {}).get("source", {}).get("source_workspace_id") or "")
except Exception:
    pass
')
  [ -n "$source" ] || die "herdr did not return the parent workspace for $repo"
  printf -v qsource '%q' "$source"
  opened=$(ssh_remote "$HERDR --session $qsession worktree open --workspace $qsource --path $qpath --focus") ||
    die "could not open task workspace $path"
  fields=$(printf '%s' "$opened" | python3 -c '
import json, sys
try:
    r = json.load(sys.stdin).get("result", {})
    root = r.get("root_pane") or {}
    fields = [r.get("workspace_id") or (r.get("workspace") or {}).get("workspace_id") or "",
              root.get("pane_id") or "", root.get("agent") or "",
              "1" if r.get("already_open") else "0"]
    print("\x1f".join(fields))
except Exception:
    pass
')
  IFS=$'\037' read -r workspace pane agent already <<< "$fields"
  [ -n "$workspace" ] || die "herdr did not return a workspace for $path"

  if [ -z "$agent" ] || [ "$created" = 1 ] || [ "$already" != 1 ]; then
    [ -n "$pane" ] || die "herdr did not return a root pane for $path"
    name=$(slugify "$TASK_ID")
    [ -n "$name" ] || name="task"
    printf -v qname '%q' "$name"
    printf -v qpane '%q' "$pane"
    printf -v qprompt '%q' "$TASK_PROMPT"
    case "$agent" in
      "")
        ssh_remote "$HERDR --session $qsession agent start $qname --kind omp --pane $qpane -- $qprompt" ||
          die "could not start OMP in $path"
        ;;
      omp)
        ssh_remote "$HERDR --session $qsession agent prompt $qpane $qprompt" ||
          die "could not prompt OMP in $path"
        ;;
      *)
        printf 'dev: workspace already has %s; attaching without replacing it\n' "$agent" >&2
        ;;
    esac
  fi
  remote_tty "$HERDR --session $qsession"
}

task_run() {
  [ $# -ge 3 ] || die "usage: dev task run OWNER/REPO pr|linear|prompt REF"
  local project="$1" kind="$2" ref="$3" repo result path created
  load_task_metadata "$project" "$kind" "$ref"
  local pr_command
  pr_command=$(pr_handoff_command "$TASK_BRANCH")
  TASK_PROMPT="$TASK_PROMPT

After pushing the branch, use gh on the box to create or open the pull request.
The exe.dev GitHub integration supplies authentication through github.int.exe.xyz;
GH_TOKEN is not expected. If the integration rejects the write, tell the user to
use local GitHub auth by running:
$pr_command"
  printf 'dev: preparing %s — %s\n' "$TASK_ID" "$TASK_TITLE"
  repo=$(ensure_remote_repo "$project") || return 1
  result=$(ensure_task_worktree "$repo") || return 1
  path="${result%%$'\037'*}"
  created="${result#*$'\037'}"
  launch_task_workspace "$path" "$created" "$repo"
}

cmd_task() {
  case "${1:-}" in
    run)  shift; task_run "$@" ;;
    plan) shift; task_plan "$@" ;;
    "")   task_wizard ;;
    *)    task_plan "$@" ;;
  esac
}

# --- action menu -----------------------------------------------------------
# Returns 1 when the user backs out, so the caller can redraw the list.
action_menu() {
  need fzf
  local path="$1" ports="$2" srv="none" out key choice
  [ -n "$ports" ] && srv="$ports"
  panel actions enter run "←/esc" back
  local -a chrome=(--header="$(basename "$path")")
  out=$(printf '%s\n' \
    "copy     copy herdr login command" \
    "pr       create or open its draft PR with local gh auth" \
    "task     create a task worktree and OMP bootstrap" \
    "herdr    attach the herdr session here" \
    "session  attach here in another herdr session" \
    "code     open in VS Code (Remote-SSH)" \
    "preview  open a running server ($srv)" \
    "env      copy .env vars into this worktree" \
    "ask      ask an agent, in this directory" \
    "shell    plain ssh shell here" \
    "rm       remove this worktree" |
    fzf --prompt='action> ' --reverse --expect=left,esc \
        "${CORNER[@]}" "${chrome[@]}") || return 1
  key=$(printf '%s\n' "$out" | sed -n 1p)
  choice=$(printf '%s\n' "$out" | sed -n 2p)
  case "$key" in left|esc) return 1 ;; esac
  [ -z "$choice" ] && return 1

  case "${choice%% *}" in
    copy)    copy_herdr_command "$path" ;;
    task)    cmd_task ;;
    pr)      open_pull_request "$path" ;;
    herdr)   open_herdr "$path" ;;
    session) local sess; sess=$(pick_session) || return 0; open_herdr "$path" "$sess" ;;
    code)    open_code "$path" ;;
    preview) open_preview "$path" "$ports" ;;
    env)     cmd_env push -p "$path" ;;
    ask)     cmd_ask -p "$path" ;;
    shell)   open_shell "$path" ;;
    rm)      rm_worktree "$path" ;;
  esac
  return 0
}

# --- picker ----------------------------------------------------------------
# NOTE: pick() runs inside $( ), i.e. a subshell — anything it assigns to a
# global is discarded. It therefore *prints* its result and resolve() unpacks it
# in the calling shell. This is what previously broke every non-default key.
CACHE=""
cleanup() { screen_leave; [ -n "$CACHE" ] && rm -f "$CACHE" "$CACHE".*; }
trap cleanup EXIT

# The preview pane and the periodic reload both read the cache while a scan may
# be in flight, so a scan lands by rename and never writes in place. A scan that
# fails leaves the last good list alone and drops a marker the status line
# reads: losing the SSH connection must not blank the browser.
#   1 unreachable   2 reachable but empty
scan_into() {
  local cache="$1" tmp="$1.$$" rc=0
  scan 2>/dev/null > "$tmp" || rc=1
  if [ "$rc" = 0 ] && [ -s "$tmp" ]; then
    mv -f "$tmp" "$cache"
    date '+%H:%M:%S' > "$cache.at"
    rm -f "$cache.err"
    return 0
  fi
  rm -f "$tmp"
  : > "$cache.err"
  [ "$rc" = 0 ] && return 2
  return 1
}

refresh_cache() {
  [ -z "$CACHE" ] && CACHE=$(mktemp "${TMPDIR:-/tmp}/dev-scan.XXXXXX")
  export DEV_CACHE="$CACHE"
  scan_into "$CACHE"
  case $? in
    1) die "could not reach $REMOTE" ;;
    2) die "no git repositories found under $RHOME" ;;
  esac
}

# Internal: the reload source fzf runs, on a timer and on ctrl-r. It prints the
# list it just scanned, or the previous one when the box did not answer.
cmd_scan() {
  local cache="${DEV_CACHE:-}"
  [ -n "$cache" ] && [ -f "$cache" ] || return 0
  scan_into "$cache" || true
  fmt < "$cache"
}

# Internal: the status line. A list that re-scans itself has to say when it last
# did, and whether the box answered.
cmd_status() {
  local cache="${DEV_CACHE:-}" at="" where="$REMOTE"
  [ -n "$BOX" ] && where="$REMOTE/$BOX"
  [ -n "$cache" ] && at=$(cat "$cache.at" 2>/dev/null || true)
  if [ -n "$cache" ] && [ -f "$cache.err" ]; then
    printf '\033[2m%s\033[0m   \033[33m%s unreachable, showing the scan from %s\033[0m\n' \
      "$where" "$REMOTE" "${at:-startup}"
  elif [ "$REFRESH_SECS" -gt 0 ] 2>/dev/null; then
    printf '\033[2m%s   scanned %s, rescans every %ss\033[0m\n' "$where" "${at:-—}" "$REFRESH_SECS"
  else
    printf '\033[2m%s   scanned %s, auto refresh off\033[0m\n' "$where" "${at:-—}"
  fi
}

# Internal: puts the cursor back on the worktree the last menu acted on, once.
# The list is relaunched from scratch each time round the loop, so without this
# every trip through a menu would drop you back at the top.
cmd_focus() {
  local cache="${DEV_CACHE:-}" want row
  [ -n "$cache" ] && [ -f "$cache.focus" ] || return 0
  want=$(cat "$cache.focus" 2>/dev/null || true)
  rm -f "$cache.focus"
  [ -n "$want" ] || return 0
  row=$(awk -F'\t' -v p="$want" '$3 == p { print NR; exit }' "$cache")
  [ -n "$row" ] && printf 'pos(%s)' "$row"
  return 0
}

pick() {
  need fzf
  local out key line path ports self tick keys cols
  local -a chrome=()
  if [ -n "${1:-}" ]; then
    local hit; hit=$(grep -i -- "$1" "$CACHE" || true)
    if [ "$(printf '%s\n' "$hit" | grep -c .)" = 1 ]; then
      printf '\t%s\t%s\n' "$(printf '%s' "$hit" | cut -f3)" "$(printf '%s' "$hit" | cut -f6)"
      return 0
    fi
  fi

  printf -v self '%q' "$0"
  cols=$(term_size); cols="${cols#* }"
  keys=$(FZF_COLUMNS="$cols" cmd_keys)

  if fzf_has_footer; then
    chrome=(--footer="$keys" --footer-border=line --info=inline-right
            --header="$(cmd_status)"
            --bind "resize:transform-footer($self _keys)")
    tick="transform($self _focus)+transform-header($self _status)+refresh-preview"
  else
    chrome=(--header="$keys")
    tick="transform($self _focus)+refresh-preview"
  fi
  # `load` fires whenever a list finishes loading, so a reload scheduled there
  # re-arms itself: one sleeping child, no background poller, and fzf kills it
  # on exit. reload-sync keeps the current list on screen while the scan runs.
  [ "$REFRESH_SECS" -gt 0 ] 2>/dev/null &&
    tick="$tick+reload-sync(sleep $REFRESH_SECS; $self _scan)"

  # --no-clear leaves the frame up when fzf exits, so the menu that follows lands
  # on top of the list instead of on a blank screen. screen_home keeps fzf from
  # scrolling the frame away when it paints again.
  [ -n "$SCREEN" ] && chrome+=(--no-clear)
  screen_home
  out=$(fmt < "$CACHE" |
        fzf --ansi --reverse --height=100% --prompt='workspace> ' --query="${1:-}" \
            "${chrome[@]}" \
            --bind "load:$tick" --bind "ctrl-r:reload-sync($self _scan)" \
            --preview="$self _pane {-1}" --preview-window='right,52%,border-left,wrap' \
            --expect=right,ctrl-n,ctrl-o,ctrl-h,ctrl-s,ctrl-p,ctrl-e) || return 1

  key=$(printf '%s\n' "$out" | sed -n 1p)
  line=$(printf '%s\n' "$out" | sed -n 2p)
  [ -z "$line" ] && return 1
  path=$(printf '%s' "$line" | awk '{print $NF}')
  ports=$(awk -F'\t' -v p="$path" '$3==p{print $6}' "$CACHE")
  printf '%s\t%s\t%s\n' "$key" "$path" "$ports"
}

REPLY_KEY=""; REPLY_PATH=""; REPLY_PORTS=""
resolve() {
  local r; r=$(pick "${1:-}") || return 1
  REPLY_KEY=$(printf '%s' "$r"  | cut -f1)
  REPLY_PATH=$(printf '%s' "$r" | cut -f2)
  REPLY_PORTS=$(printf '%s' "$r" | cut -f3)
  [ -n "$REPLY_PATH" ]
}

# --- browse loop -----------------------------------------------------------
browse() {
  local sess
  refresh_cache
  screen_enter
  while true; do
    resolve "${1:-}" || break
    set --                                   # query applies to the first pass only
    printf '%s' "$REPLY_PATH" > "$CACHE.focus"
    case "$REPLY_KEY" in
      "")      copy_herdr_command "$REPLY_PATH" ;;
      right)   action_menu "$REPLY_PATH" "$REPLY_PORTS" || continue ;;
      ctrl-n)  cmd_task || true ;;
      ctrl-o)  open_code    "$REPLY_PATH" ;;
      ctrl-h)  open_herdr   "$REPLY_PATH" ;;   # attaches, then exits
      ctrl-s)  sess=$(pick_session) && open_herdr "$REPLY_PATH" "$sess" || true ;;
      ctrl-p)  open_preview "$REPLY_PATH" "$REPLY_PORTS" || true ;;
      ctrl-e)  cmd_env push -p "$REPLY_PATH" ;;
    esac
    screen_enter                             # a remote TUI may have left it
    refresh_cache                            # state may have changed
  done
  screen_leave
  return 0
}

# --- subcommands -----------------------------------------------------------
cmd_ls() { refresh_cache; fmt < "$CACHE"; }

cmd_ps() {
  local orphans; orphans=$(scan 2>&1 >/dev/null | grep '^ORPHAN' || true)
  refresh_cache
  echo "servers in worktrees"
  awk -F'\t' '$6!=""{print $1 "\037" $6}' "$CACHE" | while IFS=$'\037' read -r repo ports; do
    for p in $(printf '%s' "$ports" | tr ',' ' '); do
      printf '  %-13s %-8s %s\n' "$repo" "${p%l}" "$(url_for "$p")"
    done
  done
  [ -n "$orphans" ] && {
    echo "other listeners"
    printf '%s\n' "$orphans" | tr '\t' '\037' |
    while IFS=$'\037' read -r _ port scope cwd cmd; do
      [ "$scope" = l ] && continue
      printf '  %-13s %-8s %s\n' "$cmd" "$port" "$(url_for "$port")"
    done
  }
  return 0
}

cmd_new() {
  local repo="" branch="" base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) base="$2"; shift 2 ;;
      *) if [ -z "$branch" ] && [ -n "$repo" ]; then branch="$1"
         elif [ -z "$repo" ]; then repo="$1"
         else branch="$1"; fi; shift ;;
    esac
  done
  [ -z "$branch" ] && { branch="$repo"; repo=""; }
  [ -z "$branch" ] && die "usage: dev new [repo] <branch> [--base ref]"

  refresh_cache
  if [ -z "$repo" ]; then
    need fzf
    repo=$(awk -F'\t' '$5=="main"{print $1"\t"$3}' "$CACHE" | sort -u |
           fzf --prompt='repo> ' --reverse --height=30% --with-nth=1 --delimiter='\t') || return 1
    repo=$(printf '%s' "$repo" | cut -f2)
  fi
  [ -z "$repo" ] && die "no repo selected"

  local slug path
  slug=$(printf '%s' "$branch" | tr '/' '-')
  path="$WT_ROOT/$(basename "$repo")/$slug"
  local args="--cwd '$repo' --branch '$branch' --path '$path' --focus"
  [ -n "$base" ] && args="$args --base '$base'"

  ssh_remote "mkdir -p '$(dirname "$path")' && $HERDR worktree create $args" >/dev/null \
    || die "worktree create failed"
  printf 'dev: created %s on %s\n' "$path" "$branch"
}

rm_worktree() {
  local path="$1" ws
  screen_wipe
  ws=$(awk -F'\t' -v p="$path" '$3==p{print $4}' "$CACHE")
  printf 'Remove worktree %s? [y/N] ' "$path"
  read -r ans; [ "$ans" = y ] || [ "$ans" = Y ] || { echo "aborted"; return 1; }
  [ -z "$ws" ] && die "not open as a workspace; open it first (dev herdr)"
  ssh_remote "$HERDR worktree remove --workspace '$ws'" >/dev/null && echo "dev: removed $path"
}

# --- env -------------------------------------------------------------------
# Values never appear on a command line: argv is world-readable via ps, and the
# agents on the box run as the same user. Everything moves over stdin, and the
# picker shows key names and value lengths only.

ENV_MERGE_PY='
import os, re, sys, time
target = os.environ["TARGET"]
incoming = {}
for line in sys.stdin.read().splitlines():
    k, sep, v = line.partition("=")
    if sep and k.strip():
        incoming[k.strip()] = v
try:
    lines = open(target).read().splitlines()
except FileNotFoundError:
    lines = []
if lines:
    bak = target + ".bak." + time.strftime("%Y%m%d%H%M%S")
    open(bak, "w").write("\n".join(lines) + "\n")
    os.chmod(bak, 0o600)
seen, out = set(), []
for line in lines:
    m = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=", line)
    if m and m.group(1) in incoming:
        out.append(m.group(1) + "=" + incoming[m.group(1)])
        seen.add(m.group(1))
    else:
        out.append(line)
added = [k for k in incoming if k not in seen]
if added:
    if out and out[-1].strip():
        out.append("")
    out.append("# added by dev env push " + time.strftime("%Y-%m-%d"))
    out += [k + "=" + incoming[k] for k in added]
open(target, "w").write("\n".join(out) + "\n")
os.chmod(target, 0o600)
print("updated %d, added %d, backup %s" % (len(seen), len(added),
      "yes" if lines else "none (new file)"))
'

env_keys_local() {
  python3 -c '
import re, sys
for line in open(sys.argv[1], errors="replace"):
    m = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$", line.rstrip("\n"))
    if not m:
        continue
    k, v = m.group(1), m.group(2).strip().strip("\"'"'"'")
    print("%s\t%s" % (k, "empty" if not v else "%s (%d chars)" % ("*" * min(len(v), 8), len(v))))
' "$1"
}

cmd_env() {
  local sub="push"
  case "${1:-}" in ls|diff|push) sub="$1"; shift ;; esac
  local from="" query="" target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="$2"; shift 2 ;;
      -p)     target="$2"; shift 2 ;;
      *)      query="$1"; shift ;;
    esac
  done
  if [ -z "$target" ]; then
    refresh_cache
    resolve "$query" || return 1
    target="$REPLY_PATH"
  fi
  local repo; repo=$(basename "$target")

  case "$sub" in
    ls)
      ssh_remote "sed -n 's/^\s*\([A-Za-z_][A-Za-z0-9_]*\)\s*=.*/\1/p' '$target/.env' 2>/dev/null" |
        sed 's/^/  /'
      ;;
    diff)
      [ -z "$from" ] && from="$HOME/dev/$repo/.env"
      [ -f "$from" ] || die "no local source: $from"
      local here there
      here=$(env_keys_local "$from" | cut -f1 | sort)
      there=$(ssh_remote "sed -n 's/^\s*\([A-Za-z_][A-Za-z0-9_]*\)\s*=.*/\1/p' '$target/.env' 2>/dev/null" | sort)
      echo "local only  ($from):";        comm -23 <(echo "$here") <(echo "$there") | sed 's/^/  + /'
      echo "remote only ($target/.env):"; comm -13 <(echo "$here") <(echo "$there") | sed 's/^/  - /'
      ;;
    push)
      need fzf
      panel env enter pick esc cancel
      [ -z "$from" ] && from="$HOME/dev/$repo/.env"
      if [ ! -f "$from" ]; then
        from=$(find "$HOME/dev" -maxdepth 2 -name '.env*' -not -path '*/node_modules/*' 2>/dev/null |
               fzf --prompt='source .env> ' --reverse "${CORNER[@]}") || return 1
      fi
      [ -f "$from" ] || die "no source file"

      local keys
      panel env tab select enter push esc cancel
      keys=$(env_keys_local "$from" | awk -F'\t' '{printf "%-32s %s\n", $1, $2}' |
             fzf --multi --prompt='vars to copy> ' --reverse "${CORNER[@]}" \
                 --header="$from  →  $REMOTE:$target/.env    tab = select, enter = push" |
             awk '{print $1}') || return 1
      screen_wipe
      [ -z "$keys" ] && { echo "nothing selected"; return 0; }

      local n; n=$(printf '%s\n' "$keys" | grep -c .)
      printf 'Copy %d var(s) to %s:%s/.env? [y/N] ' "$n" "$REMOTE" "$target"
      read -r ans; [ "$ans" = y ] || [ "$ans" = Y ] || { echo "aborted"; return 1; }

      ssh_remote "TARGET='$target/.env' python3 -c \"\$(printf %s '$(printf '%s' "$ENV_MERGE_PY" | base64)' | base64 -d)\"" \
        < <(while IFS= read -r k; do
              [ -z "$k" ] && continue
              grep -m1 -E "^[[:space:]]*$k[[:space:]]*=" "$from" | sed 's/^[[:space:]]*//'
            done <<< "$keys")
      ;;
  esac
}

# --- ask -------------------------------------------------------------------
cmd_ask() {
  local agent="claude" query="" question="" path=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent|-a) agent="$2"; shift 2 ;;
      -w)         query="$2"; shift 2 ;;
      -p)         path="$2"; shift 2 ;;
      *)          question="${question:+$question }$1"; shift ;;
    esac
  done

  local one
  case "$agent" in
    claude) one='claude -p "$P"' ;;
    gemini) one='gemini -p "$P"' ;;
    grok)   one='grok -p "$P"' ;;
    codex)  one='codex exec --skip-git-repo-check "$P"' ;;
    *)      die "unknown agent: $agent (claude|codex|gemini|grok)" ;;
  esac

  if [ -z "$path" ]; then
    refresh_cache
    resolve "$query" || return 1
    path="$REPLY_PATH"
  fi

  if [ -z "$question" ]; then
    remote_tty "cd '$path' && export PATH=\$HOME/.local/bin:\$PATH && exec $agent"
  fi
  printf '%s' "$question" |
    ssh_remote "cd '$path' && export PATH=\$HOME/.local/bin:\$PATH && P=\$(cat) && $one"
}


# --- box provisioning ------------------------------------------------------
cmd_box_new() {
  local name="" project="" yes="" arg
  while [ $# -gt 0 ]; do
    arg="$1"
    shift
    case "$arg" in
      --yes|-y) yes=yes ;;
      -* ) die "unknown box option: $arg" ;;
      *)
        if [ -z "$name" ]; then
          name="$arg"
        elif [ -z "$project" ]; then
          project="$arg"
        else
          die "usage: dev -H PROFILE box new [NAME] [OWNER/REPO] [--yes]"
        fi
        ;;
    esac
  done
  provision_box "$name" "$project" "$yes"
}

cmd_box() {
  local action="${1:-}"
  shift || true
  case "$action" in
    bootstrap)
      [ $# -eq 1 ] || die "usage: dev -H PROFILE -B BOX box bootstrap OWNER/REPO"
      case "$1" in */*) ;; *) die "project must be OWNER/REPO: $1" ;; esac
      setup_box_project "$1"
      printf 'dev: %s is ready with %s and OMP\n' "$BOX" "$1"
      ;;
    *) die "usage: dev box new [NAME] [OWNER/REPO] [--yes] | dev box bootstrap OWNER/REPO" ;;
  esac
}
# --- main ------------------------------------------------------------------
main() {
  local sess
  while [ $# -gt 0 ]; do
    case "$1" in
      -H|--host|-r|--remote)
        if [ $# -ge 2 ]; then
          REMOTE="$2"
          shift 2
        else
          REMOTE=$(pick_ssh_profile) || return 0
          shift
        fi
        ;;
      --host=*|--remote=*)
        REMOTE="${1#*=}"
        [ -n "$REMOTE" ] || die "SSH host cannot be empty"
        shift
        ;;
      -P|--profile|--pick-profile)
        REMOTE=$(pick_ssh_profile) || return 0
        shift
        ;;
      -B|--box)
        [ $# -ge 2 ] || die "missing box name after $1"
        BOX="$2"
        shift 2
        ;;
      --box=*)
        BOX="${1#*=}"
        [ -n "$BOX" ] || die "box name cannot be empty"
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done
  # The footer, the status line and the cursor restore are pure layout, so they
  # answer before configure_remote spends an `ssh -G` on them: these run on every
  # refresh and on every resize, and have to stay cheap.
  case "${1:-}" in
    -h|--help)
      awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"
      return
      ;;
    _keys)   cmd_keys; return ;;
    _status) cmd_status; return ;;
    _focus)  cmd_focus; return ;;
    _fleet_rows) cmd_fleet_rows; return ;;
  esac


  # Creating a box addresses the exe.dev lobby itself, not an existing VM.
  if [ "${1:-}" = "box" ] && [ "${2:-}" = "new" ]; then
    shift 2
    cmd_box_new "$@"
    return
  fi

  # Fleet monitoring addresses every box behind one exe.dev lobby profile.
  # It must run before configure_remote narrows that profile to a single VM.
  if [ "${1:-}" = "fleet" ]; then
    shift
    export DEV_REMOTE="$REMOTE" DEV_BOX="@fleet"
    case "${1:-}" in
      ls|list) cmd_fleet_ls ;;
      "")      fleet_browse ;;
      *)       die "usage: dev -H PROFILE fleet [ls]" ;;
    esac
    return
  fi
  configure_remote || return
  if [ "$BOX" = "@fleet" ]; then
    export DEV_REMOTE="$REMOTE" DEV_BOX="$BOX"
    case "${1:-}" in
      ls|list) cmd_fleet_ls ;;
      "")      fleet_browse ;;
      *)       die "fleet selection supports the list browser or ls" ;;
    esac
    return
  fi

  case "${1:-}" in
    _pane)     shift; cmd_pane "$@" ;;          # internal: fzf preview
    _scan)     shift; cmd_scan "$@" ;;          # internal: fzf reload source
    ls|list)   shift; cmd_ls "$@" ;;
    ps)        shift; cmd_ps "$@" ;;
    new|add)   shift; cmd_new "$@" ;;
    env)       shift; cmd_env "$@" ;;
    github)    shift; cmd_github "$@" ;;
    ask|\?)    shift; cmd_ask "$@" ;;
    box)       shift; cmd_box "$@" ;;
    rm|remove) shift; refresh_cache; resolve "${1:-}" && rm_worktree "$REPLY_PATH" ;;
    code)      shift; refresh_cache; resolve "${1:-}" && open_code "$REPLY_PATH" ;;
    pr)        shift; refresh_cache; resolve "${1:-}" && open_pull_request "$REPLY_PATH" ;;
    copy|cp)  shift; refresh_cache; resolve "${1:-}" && copy_herdr_command "$REPLY_PATH" ;;
    task|work) shift; cmd_task "$@" ;;
    herdr|h)   shift
               sess=""
               case "${1:-}" in
                 -s|--session) sess="${2:-}"; shift 2 ;;
                 --session=*)  sess="${1#--session=}"; shift ;;
                 --pick|-S)    shift; sess=$(pick_session) || exit 0 ;;
               esac
               refresh_cache; resolve "${1:-}" && open_herdr "$REPLY_PATH" "${sess:-$SESSION}" ;;
    sessions|s) shift
               sessions_list | awk -F'\t' 'NF{printf "  %-20s %-8s %s\n", $1, $2, $3}' ;;
    preview|p) shift; refresh_cache; resolve "${1:-}" && open_preview "$REPLY_PATH" "$REPLY_PORTS" ;;
    *)         browse "${1:-}" ;;
  esac
}

main "$@"
